<%- include('partials/head') %>

<section class="hero">
  <h1>搜索</h1>
  <form class="searchform" action="/search" method="get">
    <input type="search" name="q" value="<%= query %>" placeholder="中英文都可以…" autofocus aria-label="搜索词">
    <select name="section" aria-label="按分区过滤">
      <option value="">全部分区</option>
      <% sections.forEach(row => { %>
        <option value="<%= row.section %>" <%= row.section === section ? 'selected' : '' %>><%= row.section %></option>
      <% }) %>
    </select>
    <select name="tag" aria-label="按标签过滤">
      <option value="">全部标签</option>
      <% tags.forEach(row => { %>
        <option value="<%= row.tag %>" <%= row.tag === tag ? 'selected' : '' %>><%= row.tag %></option>
      <% }) %>
    </select>
    <button class="button" type="submit">搜索</button>
  </form>
</section>

<% if (query) { %>
  <section class="results-section" aria-labelledby="search-results-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">检索结果</span>
        <h2 id="search-results-title">找到 <%= results.length %> 篇</h2>
      </div>
      <% if (section || tag) { %><a class="button quiet small" href="/search?q=<%= encodeURIComponent(query) %>">清除筛选</a><% } %>
    </div>
    <% if (usedFallback) { %>
      <p class="muted">部分结果使用子串匹配：分词边界与查询词不一致时，会自动走这条兜底路径。</p>
    <% } %>

    <ul class="results">
    <% results.forEach(row => { %>
      <li>
        <a class="result-title" href="/note/<%= encodePath(row.path) %>"><%= row.title %></a>
        <% if (row.section) { %><span class="chip"><%= row.section %></span><% } %>
        <span class="chip via via-<%= row.via %>"><%= row.via === 'fts' ? '全文' : '子串' %></span>
        <p class="snippet"><%= row.snippet %></p>
        <p class="muted path"><%= row.path %></p>
      </li>
    <% }) %>
  </ul>

    <% if (results.length === 0) { %>
      <div class="empty-inline">
        <p>没有找到匹配的笔记。</p>
        <p class="muted">换个词试试，或者清除分区与标签筛选。</p>
      </div>
    <% } %>
  </section>
<% } %>

<%- include('partials/foot') %>
