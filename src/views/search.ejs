<%- include('partials/head') %>
<%
  const browsing = typeof isBrowsing !== 'undefined' ? isBrowsing : !query;
  const sectionName = ui.sectionName;
  const filtered = Boolean(section || tag || query);
%>
<div class="library">
<header class="page-head">
  <h1>笔记</h1>
  <%# 普通按钮，不用实心蓝：这一页主要是找笔记，新建在侧栏的「+」里随时都有。 %>
  <% if (!readOnly) { %><a class="button" href="/new"><svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>新建笔记</a><% } %>
</header>

<form class="library-filters" action="/search" method="get" role="search" aria-label="搜索与筛选笔记">
  <div class="library-search">
    <svg class="search-glyph" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <label class="visually-hidden" for="library-search-input">搜索笔记</label>
    <input id="library-search-input" type="search" name="q" value="<%= query || '' %>" placeholder="搜索笔记" autocomplete="off">
    <kbd aria-hidden="true">/</kbd>
    <button type="button" class="library-search-clear" data-search-clear aria-label="清空搜索词" hidden>×</button>
  </div>
  <label class="select-field"><span class="visually-hidden">分区</span><select name="section" data-auto-submit><option value="">全部分区</option><% sections.forEach(row => { %><option value="<%= row.section %>"<% if (row.section === section) { %> selected<% } %>><%= sectionName(row.section) %></option><% }) %></select></label>
  <% if (tags.length) { %><label class="select-field"><span class="visually-hidden">标签</span><select name="tag" data-auto-submit><option value="">全部标签</option><% tags.forEach(row => { %><option value="<%= row.tag %>"<% if (row.tag === tag) { %> selected<% } %>><%= row.tag %></option><% }) %></select></label><% } %>
  <% if (filtered) { %><a class="library-clear" href="/search">清除</a><% } %>
</form>

<section class="library-collection" aria-labelledby="library-results-title">
  <div class="library-list-heading"><h2 id="library-results-title"><%= browsing ? (section ? sectionName(section) : '最近修改') : '匹配的笔记' %></h2><span><% if (browsing) { %>共 <%= total %> 篇<% if (pages > 1) { %> · 第 <%= page %> / <%= pages %> 页<% } %><% } else { %><%= results.length %> 篇<% } %></span></div>
  <% if (results.length) { %>
    <ul class="library-list">
      <% results.forEach(row => { const modified = row.mtime_ms || row.mtimeMs; const excerpt = browsing ? '' : ui.excerptHtml(row.snippet, query); %>
        <li><a class="library-document" href="/note/<%= encodePath(row.path) %>">
          <span class="library-document-content">
            <strong><%= row.title %></strong>
            <% if (excerpt) { %><span class="library-excerpt"><%- excerpt %></span><% } %>
          </span>
          <span class="library-document-meta"><% if (!section) { %><span title="<%= sectionName(row.section) %>"><%= sectionName(row.section) %></span><% } %><% if (modified) { %><time datetime="<%= new Date(modified).toISOString() %>"><%= ui.modifiedLabel(modified, today) %></time><% } %></span>
        </a></li>
      <% }) %>
    </ul>
    <% if (browsing && pages > 1) { const pageHref = n => '/search?page=' + n + (section ? '&section=' + encodeURIComponent(section) : '') + (tag ? '&tag=' + encodeURIComponent(tag) : ''); %>
      <nav class="library-pager" aria-label="翻页">
        <% if (page > 1) { %><a class="button small quiet" href="<%= pageHref(page - 1) %>">← 上一页</a><% } else { %><span></span><% } %>
        <span>第 <%= page %> / <%= pages %> 页</span>
        <% if (page < pages) { %><a class="button small quiet" href="<%= pageHref(page + 1) %>">下一页 →</a><% } else { %><span></span><% } %>
      </nav>
    <% } else if (!browsing && results.length >= pageSize) { %>
      <p class="library-more-hint">只列出最相关的 <%= pageSize %> 篇。换一个更具体的词，或按分区、标签筛选。</p>
    <% } %>
  <% } else { %>
    <div class="library-empty empty-state">
      <h2><%= filtered ? '没有匹配的笔记' : '还没有笔记' %></h2>
      <% if (filtered) { %><a class="button" href="/search">查看全部笔记</a><% } else if (!readOnly) { %><a class="button" href="/new">写第一篇笔记</a><% } %>
    </div>
  <% } %>
</section>
</div>

<%- include('partials/foot') %>
