<%- include('partials/head') %>
<%
  const mod = isMac ? '⌘' : 'Ctrl ';
  const due = ui.addDays(today, 7);
  const ok = '<svg class="guide-status-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
  const todo = '<svg class="guide-status-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7"/></svg>';
  const needsTerminal = !git.isRepository || !git.hasIdentity;
  const gitRows = [
    { done: git.installed, label: git.installed ? '已安装 Git' : '没有检测到 Git' },
    { done: git.isRepository, label: git.isRepository ? '资料库已是 Git 仓库' : '资料库还不是 Git 仓库' },
    { done: git.hasIdentity, label: git.hasIdentity ? '已配置提交身份（user.name / user.email）' : '还没有配置提交身份' },
    { done: git.syncEnabled && !git.readOnly, label: git.readOnly ? '只读模式下不会自动提交笔记' : git.syncEnabled ? '已开启自动同步' : '自动同步未开启' },
    { done: git.hasRemote, optional: true, label: git.hasRemote ? '已配置远端，同步时会推送' : '没有远端，只在本机提交（可选）' }
  ];
%>
<div class="guide-page">

<header class="page-head">
  <h1>上手指南</h1>
  <button type="button" class="button" data-guide-start>
    <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5Z"/></svg>
    重新看界面导览
  </button>
</header>

<%# 清单全部做完时今日页本来就不显示它，这条「重新显示」的提示也就没有意义。 %>
<% if (checklistHidden && !readOnly && !progress.complete) { %>
  <div class="notice guide-restore" data-onboarding-restore>
    <p>今日页的上手清单已隐藏。</p>
    <button type="button" class="button small" data-onboarding-show>在今日页重新显示</button>
  </div>
<% } %>

<%- include('partials/onboarding', { progress, variant: 'guide' }) %>

<nav class="guide-toc" aria-label="速查目录">
  <a href="#notes">笔记与公式</a>
  <a href="#keys">搜索与快捷键</a>
  <a href="#plan">待办与计划</a>
