<%- include('partials/head') %>
<section class="hero">
  <span class="eyebrow">听力与口语</span>
  <h1>影子跟读</h1>
  <p class="muted">把音频和字幕放进 vault 的 <code>audio/&lt;名字&gt;/</code> 目录，这里就会列出来。</p>
  <% if (!whisperReady) { %>
    <p class="muted integration-status">whisper.cpp 不可用<% if (whisperPath) { %>（<code><%= whisperPath %></code>）<% } %>，
      不能自动转字幕。<strong>已经有 SRT 的素材照常能练</strong>。
      要开启自动转写，请在应用设置中选择 whisper.cpp 和模型文件。</p>
  <% } %>
</section>

<% if (clips.length === 0) { %>
  <section class="card empty">
    <h2>还没有素材</h2>
    <p>目录结构：</p>
    <pre><code>audio/
└── isr-keynote-2026/
    ├── audio.m4a
    └── audio.srt   ← 可选，没有可以用 whisper 生成</code></pre>
    <p class="muted">音频支持 m4a / mp3 / wav / ogg / opus / flac / webm。</p>
  </section>
<% } else { %>
  <ul class="notelist">
    <% clips.forEach(clip => { %>
      <li>
        <a href="/shadowing/<%= encodeURIComponent(clip.id) %>"><%= clip.id %></a>
        <% if (clip.hasSubtitles) { %><span class="chip"><%= clip.cueCount %> 句</span>
        <% } else { %><span class="chip" style="border-color:var(--missing);color:var(--missing)">没有字幕</span><% } %>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('partials/foot') %>
