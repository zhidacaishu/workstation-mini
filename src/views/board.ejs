<%- include('partials/head') %>
<%
  const statusIcon = {
    planned: '<span class="status-mark is-planned" aria-hidden="true"></span>',
    running: '<span class="status-mark is-running" aria-hidden="true"></span>',
    done: '<svg class="status-icon is-done" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>',
    abandoned: '<svg class="status-icon is-abandoned" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="m6.5 17.5 11-11"/></svg>'
  };
%>
<header class="page-head">
  <%# 每一栏标题旁都有数目，页头不再写「共 N 个项目」。 %>
  <h1><%= workflow.label %></h1>
  <% if (!readOnly) { %><a class="button" href="/new?folder=<%= encodeURIComponent(workflow.section) %>"><svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>新建项目</a><% } %>
</header>

<% if (total === 0) { %>
  <section class="panel empty-state board-onboarding">
    <h2>还没有<%= workflow.noun %></h2>
    <p><%= readOnly ? '项目用于记录进展、下一步和结论。' : '创建项目，记录进展、下一步和结论。' %></p>
  </section>
<% } else { %>
  <div class="board" data-board data-workflow="<%= workflow.key %>">
    <% columns.forEach(column => { %>
      <section class="board-col <%= column.muted ? 'is-muted' : '' %> <%= column.warn ? 'is-warn' : '' %>" data-board-column data-status="<%= column.key %>" aria-labelledby="board-col-<%= column.key %>">
        <h2 id="board-col-<%= column.key %>"><%- statusIcon[column.key] || statusIcon.planned %><span><%= column.label %></span><span class="count" data-column-count><%= column.items.length %></span></h2>
        <div class="board-items" data-board-items>
        <% column.items.forEach(item => {
          const deadline = ui.toDateString(item.data.deadline);
          const active = item.status !== 'done' && item.status !== 'abandoned';
          const overdue = active && deadline && deadline < today;
          const dataset = ui.fieldText(item.data.dataset);
          const next = ui.fieldText(item.data.next);
          const result = ui.fieldText(item.data.result || item.data.conclusion);
        %>
          <article class="board-card" data-board-card data-path="<%= item.path %>" data-status="<%= item.status %>" data-hash="<%= item.hash %>">
            <a class="board-title" href="/note/<%= encodePath(item.path) %>"><%= item.title %></a>

            <% if (dataset) { %>
              <p class="board-dataset" aria-label="数据集：<%= dataset %>" title="<%= dataset %>"><%= dataset %></p>
            <% } %>
            <% if (result) { %>
              <p class="board-next" data-board-result<% if (item.status !== 'done') { %> hidden<% } %>><span>结果</span><%= result %></p>
            <% } %>
            <% if (next) { %>
              <p class="board-next" data-board-next<% if (item.status === 'done' && result) { %> hidden<% } %>><span>下一步</span><%= next %></p>
            <% } %>

            <% if (deadline) { %><footer class="board-card-footer"><time datetime="<%= deadline %>" class="board-deadline<%= overdue ? ' is-overdue' : active && deadline === today ? ' is-today' : '' %>" data-board-deadline data-deadline-state="<%= deadline < today ? 'overdue' : deadline === today ? 'today' : '' %>" data-active-label="<%= deadline < today ? '逾期 ' : '截止 ' %><%= ui.shortDate(deadline, today) %>" data-inactive-label="截止 <%= ui.shortDate(deadline, today) %>"><%= overdue ? '逾期 ' : '截止 ' %><%= ui.shortDate(deadline, today) %></time></footer><% } %>

            <% if (!readOnly) { %>
              <form class="statusform" action="/board/status" method="post">
                <input type="hidden" name="workflow" value="<%= workflow.key %>">
                <input type="hidden" name="path" value="<%= item.path %>">
                <input type="hidden" name="expectedHash" value="<%= item.hash %>">
                <label class="select-field small">
                  <span class="visually-hidden">改变「<%= item.title %>」的状态</span>
                  <select name="status" data-auto-submit aria-label="改变「<%= item.title %>」的状态" title="改变状态">
                    <% workflow.statuses.forEach(status => { %>
                      <option value="<%= status.key %>" <%= status.key === item.status ? 'selected' : '' %>><%= status.label %></option>
                    <% }) %>
                  </select>
                </label>
              </form>
            <% } %>
          </article>
        <% }) %>
        </div>
      </section>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>
