<%- include('partials/head') %>

<section class="hero">
  <span class="eyebrow">文献全文</span>
  <h1>PDF 全文搜索</h1>
  <p class="muted">只检索已经通过 MinerU 解析并建立索引的 Zotero PDF，不会混入普通笔记结果。</p>
  <form class="searchform" action="/library/pdfs/search" method="get" role="search">
    <input type="search" name="q" value="<%= pdfQuery %>" placeholder="搜索 PDF 正文…" autofocus aria-label="搜索 PDF 正文">
    <button class="button" type="submit">搜索</button>
    <a class="button quiet" href="/library">返回文献</a>
  </form>
</section>

<% if (pdfQuery) { %>
  <section class="results-section" aria-labelledby="pdf-search-results-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">检索结果</span>
        <h2 id="pdf-search-results-title">找到 <%= results.length %> 个正文片段</h2>
      </div>
    </div>
    <% if (usedFallback) { %>
      <p class="muted">部分结果使用子串匹配：分词边界与查询词不一致时，会自动走这条兜底路径。</p>
    <% } %>

    <ul class="results pdf-results">
      <% results.forEach(row => { %>
        <li>
          <a class="result-title" href="/library/pdfs/<%= row.documentId %>?chunk=<%= row.chunkIndex %>#chunk-<%= row.chunkIndex %>"><%= row.title %></a>
          <span class="chip">第 <%= row.pageNumber %> 页</span>
          <% if (row.heading) { %><span class="chip"><%= row.heading %></span><% } %>
          <span class="chip via via-<%= row.via %>"><%= row.via === 'fts' ? '全文' : '子串' %></span>
          <p class="snippet"><%= row.snippet %></p>
          <p class="muted path"><%= row.fileName %></p>
        </li>
      <% }) %>
    </ul>

    <% if (results.length === 0) { %>
      <div class="empty-inline">
        <p>没有找到匹配的 PDF 正文。</p>
        <p class="muted">换个词试试，或者返回文献页解析更多 PDF。</p>
      </div>
    <% } %>
  </section>
<% } %>

<%- include('partials/foot') %>
