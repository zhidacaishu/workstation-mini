<%- include('partials/head') %>
<div class="narrow card-edit">

<header class="page-head">
  <%# 卡组文件就在下面的「卡组文件」里，标题下不再重复一遍路径。 %>
  <h1>编辑卡片</h1>
  <div class="actions">
    <a class="button quiet" href="<%= returnTo %>">取消</a>
    <button class="button primary" type="submit" form="card-edit-form">保存</button>
  </div>
</header>

<form id="card-edit-form" class="panel card-edit-form" action="/cards/update" method="post" data-card-editor>
  <input type="hidden" name="id" value="<%= card.id %>">
  <input type="hidden" name="expectedHash" value="<%= expectedHash %>">
  <input type="hidden" name="returnTo" value="<%= returnTo %>">

  <label class="card-field">
    <span>正面</span>
    <input id="card-front" type="text" name="front" value="<%= card.front %>" required autocomplete="off" spellcheck="false">
  </label>
  <div class="card-field card-back-field">
    <label for="card-back">背面</label>
    <%# 宽窗口下右边是这张卡排好的样子：公式、挖空不用保存就能看到。 %>
    <div class="card-back-panes" data-preview-host>
      <textarea id="card-back" name="back" rows="10" spellcheck="false" data-md-editor data-preview="#card-preview" data-preview-kind="card" data-preview-front="#card-front" aria-controls="link-suggest"><%= card.back %></textarea>
      <section id="card-preview" class="card-preview" aria-label="预览" hidden>
        <div class="card-preview-front" data-preview-front></div>
        <div class="card-preview-back review-back" data-preview-body></div>
      </section>
    </div>
    <small>支持 Markdown、<code>$公式$</code> 和 <code>{{挖空}}</code>。</small>
  </div>
  <label class="card-field">
    <span>卡组文件</span>
    <span class="card-deck-input"><span aria-hidden="true">cards/</span><input type="text" name="deckFile" value="<%= card.deckFile %>" list="deck-files" autocomplete="off" spellcheck="false"><span aria-hidden="true">.md</span></span>
    <datalist id="deck-files">
      <% deckFiles.forEach(item => { %><option value="<%= item.file %>"><%= item.deck %></option><% }) %>
    </datalist>
    <small>改成别的卡组文件会把这张卡挪过去，文件不存在时会新建。改正面或挪卡组，复习记录都会保留。</small>
  </label>
  <label class="card-check">
    <input type="checkbox" name="suspended"<% if (card.suspended) { %> checked<% } %>>
    <span>暂停复习<small>暂停后不再出现在复习队列里，随时可以恢复。</small></span>
  </label>

  <p class="notice is-warn" data-card-error role="alert" hidden></p>
  <div class="card-edit-actions">
    <button class="button danger card-delete" type="submit" form="card-delete-form">删除这张卡</button>
  </div>
</form>

<form id="card-delete-form" action="/cards/delete" method="post" data-confirm="删除前的卡组会存进「历史与草稿」，需要时可以在那里恢复。">
  <input type="hidden" name="id" value="<%= card.id %>">
  <input type="hidden" name="expectedHash" value="<%= expectedHash %>">
  <input type="hidden" name="returnTo" value="<%= returnTo %>">
</form>

</div>
<%- include('partials/foot') %>
