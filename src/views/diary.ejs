<%- include('partials/head') %>

<section class="hero">
  <h1>日记</h1>
  <% if (!readOnly) { %>
    <form class="inline-form" action="/diary/today" method="post">
      <input type="hidden" name="date" value="<%= today %>">
      <button class="button primary" type="submit">
        <%= todayExists ? '打开今天的日记' : '写今天的日记' %>
      </button>
      <span class="muted"><%= today %></span>
    </form>
  <% } %>
</section>

<% if (onThisDay.length) { %>
  <section class="onthisday">
    <h2>历年今日</h2>
    <ul class="notelist">
      <% onThisDay.forEach(entry => { %>
        <li>
          <span class="chip"><%= entry.label %></span>
          <a href="/note/<%= encodePath(entry.path) %>"><%= entry.title %></a>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section class="trends">
  <h2>近 30 天</h2>

  <% if (summary.entryCount === 0) { %>
    <p class="muted">这 30 天还没有日记。</p>
  <% } else { %>
    <div class="statrow">
      <div class="stat">
        <span class="stat-label">有日记</span>
        <span class="stat-value"><%= summary.entryCount %><span class="stat-unit">/30 天</span></span>
      </div>
      <% if (summary.moodAverage !== null) { %>
        <div class="stat">
          <span class="stat-label">平均情绪</span>
          <span class="stat-value"><%= summary.moodAverage.toFixed(1) %><span class="stat-unit">/5</span></span>
        </div>
      <% } %>
      <% if (summary.focusAverage !== null) { %>
        <div class="stat">
          <span class="stat-label">日均专注</span>
          <span class="stat-value"><%= Math.round(summary.focusAverage) %><span class="stat-unit">分钟</span></span>
        </div>
        <div class="stat">
          <span class="stat-label">累计专注</span>
          <span class="stat-value"><%= (summary.focusTotal / 60).toFixed(1) %><span class="stat-unit">小时</span></span>
        </div>
      <% } %>
    </div>

    <%- include('partials/trendchart', {
      series, field: 'mood', label: '情绪', unit: '', hue: 'blue', max: 5,
      format: v => String(v)
    }) %>

    <%- include('partials/trendchart', {
      series, field: 'focusMinutes', label: '专注时长', unit: ' 分钟', hue: 'orange', max: 0,
      format: v => String(Math.round(v))
    }) %>

    <%
      const recorded = series.filter(d => d.hasEntry);
    %>
    <% if (recorded.length) { %>
      <details class="tableview">
        <summary>看数字</summary>
        <table>
          <thead><tr><th>日期</th><th>情绪</th><th>专注（分钟）</th></tr></thead>
          <tbody>
            <% recorded.slice().reverse().forEach(point => { %>
              <tr>
                <td><a href="/note/<%= encodePath('diary/' + point.date + '.md') %>"><%= point.date %></a> <span class="muted"><%= point.weekday %></span></td>
                <td><%= point.mood === null ? '—' : point.mood %></td>
                <td><%= point.focusMinutes === null ? '—' : Math.round(point.focusMinutes) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </details>
    <% } %>
  <% } %>
</section>

<section>
  <h2>全部日记 <span class="count"><%= entries.length %></span></h2>
  <% if (entries.length === 0) { %>
    <p class="muted">还没有日记。</p>
  <% } %>
  <ul class="notelist">
    <% entries.forEach(entry => { %>
      <li>
        <a href="/note/<%= encodePath(entry.path) %>"><%= entry.date || entry.title %></a>
        <span class="muted"><%= entry.weekday %></span>
        <% if (entry.mood !== null) { %><span class="chip">情绪 <%= entry.mood %></span><% } %>
        <% if (entry.focusMinutes !== null) { %><span class="chip">专注 <%= Math.round(entry.focusMinutes) %> 分钟</span><% } %>
      </li>
    <% }) %>
  </ul>
</section>

<%- include('partials/foot') %>
