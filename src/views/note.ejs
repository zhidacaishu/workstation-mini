<%- include('partials/head') %>

<div class="note-layout">
<article class="note">
  <header class="note-header">
    <h1><%= note.title %></h1>
    <p class="muted path"><%= note.path %></p>
    <% if (note.tags.length) { %>
      <ul class="chiplist inline">
        <% note.tags.forEach(tag => { %>
          <li><a class="chip" href="/search?tag=<%= encodeURIComponent(tag) %>&q=<%= encodeURIComponent(tag) %>"><%= tag %></a></li>
        <% }) %>
      </ul>
    <% } %>
    <% if (!readOnly) { %>
      <div class="actions">
        <a class="button" href="/edit/<%= encodePath(note.path) %>">编辑</a>
        <details class="note-more">
          <summary class="button quiet">更多</summary>
          <a href="/history?path=<%= encodeURIComponent(note.path) %>">版本历史与草稿</a>
          <form action="/delete" method="post" data-confirm-delete>
            <input type="hidden" name="path" value="<%= note.path %>">
            <input type="hidden" name="expectedHash" value="<%= note.hash %>">
            <button class="button danger" type="submit">删除笔记</button>
          </form>
        </details>
      </div>
    <% } %>
  </header>

  <div class="prose"><%- html %></div>
</article>

<aside class="panel">
  <section>
    <h2>反向链接 <span class="count"><%= backlinks.length %></span></h2>
    <% if (backlinks.length === 0) { %>
      <p class="muted">还没有笔记链到这里。</p>
    <% } %>
    <ul class="notelist">
      <% backlinks.forEach(link => { %>
        <li><a href="/note/<%= encodePath(link.path) %>"><%= link.title %></a></li>
      <% }) %>
    </ul>
  </section>

  <% if (outbound.length) { %>
    <section>
      <h2>指向 <span class="count"><%= outbound.length %></span></h2>
      <ul class="notelist">
        <% outbound.forEach(link => { %>
          <li><a href="/note/<%= encodePath(link.path) %>"><%= link.target %></a></li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <% if (pending.length) { %>
    <section>
      <h2>待建 <span class="count"><%= pending.length %></span></h2>
      <p class="muted">链到了还没写的笔记。</p>
      <ul class="notelist">
        <% pending.forEach(link => { %>
          <li><a class="wikilink-missing" href="/new?path=<%= encodeURIComponent(link.target) %>"><%= link.target %></a></li>
        <% }) %>
      </ul>
    </section>
  <% } %>
</aside>
</div>

<%- include('partials/foot') %>
