<%- include('partials/head') %>
<%
  const isProject = note.section === 'experiments' && note.data && note.data.status;
  const projectFields = isProject
    ? ['dataset', 'params', 'seed', 'commit'].map(key => [key, ui.fieldText(note.data[key])]).filter(([, value]) => value)
    : [];
  const outcome = isProject ? ['result', 'conclusion'].map(key => [key === 'result' ? '结果' : '结论', ui.fieldText(note.data[key])]).filter(([, value]) => value) : [];
  const deadline = isProject ? ui.toDateString(note.data.deadline) : '';
  const active = isProject && note.data.status !== 'done' && note.data.status !== 'abandoned';
  const next = isProject ? ui.fieldText(note.data.next) : '';
  const hasSidebar = outline.length > 0 || backlinks.length > 0;
  const sidebarView = outline.length ? 'outline' : 'backlinks';
%>
<div class="note-layout<%= hasSidebar ? '' : ' is-single' %>">
  <article class="note">
    <header class="note-header">
      <div class="note-title-row">
        <h1><%= note.title %></h1>
        <% if (!readOnly) { %>
          <div class="note-actions">
            <a class="button" href="/edit/<%= encodePath(note.path) %>"><svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4ZM13 7l4 4"/></svg>编辑</a>
            <details class="note-more">
              <summary class="button icon-button" aria-label="更多操作" title="更多操作"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="19" cy="12" r="1.4"/></svg></summary>
              <div class="note-more-menu">
                <a href="/history?path=<%= encodeURIComponent(note.path) %>">版本历史与草稿</a>
                <form action="/delete" method="post" data-confirm-delete>
                  <input type="hidden" name="path" value="<%= note.path %>">
                  <input type="hidden" name="expectedHash" value="<%= note.hash %>">
                  <button class="menu-danger" type="submit">删除笔记</button>
                </form>
              </div>
            </details>
          </div>
        <% } %>
      </div>
      <div class="note-meta">
        <% if (hasSidebar) { %><a class="note-navigation-jump" href="#note-navigation">目录与反向链接</a><% } %>
        <% if (note.section) { %><a class="note-section" href="/search?section=<%= encodeURIComponent(note.section) %>"><%= ui.sectionName(note.section) %></a><% } %>
        <% note.tags.forEach(tag => { %><a class="note-tag" href="/search?tag=<%= encodeURIComponent(tag) %>">#<%= tag %></a><% }) %>
        <% if (note.mtimeMs) { %><span><%= ui.modifiedLabel(note.mtimeMs, today) %>修改</span><% } %>
      </div>
    </header>

    <% if (isProject) { %>
      <section class="project-summary" aria-label="项目信息">
        <p class="project-summary-head">
          <span class="status-label is-<%= note.data.status %>"><span class="status-mark" aria-hidden="true"></span><%= ui.PROJECT_STATUS[note.data.status] || note.data.status %></span>
          <% if (deadline) { %><span class="research-deadline<%= active && deadline < today ? ' is-overdue' : '' %>">截止 <%= ui.shortDate(deadline, today) %><% if (active) { %> · <%= ui.dueRelative(deadline, today) %><% } %></span><% } %>
        </p>
        <% if (next && active) { %><p class="research-next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg><span><%= next %></span></p><% } %>
        <% outcome.forEach(([label, value]) => { %><p class="project-outcome"><span><%= label %></span><%= value %></p><% }) %>
        <% if (projectFields.length) { %>
          <dl class="project-fields">
            <% projectFields.forEach(([key, value]) => { %><div><dt><%= key %></dt><dd><%= value %></dd></div><% }) %>
          </dl>
        <% } %>
      </section>
    <% } %>

    <% if (parseError) { %>
      <section class="notice is-warn note-parse-error" role="alert">
        <p><strong>这篇笔记的 frontmatter 无法解析，下面显示的是原文。</strong></p>
        <p><%= parseError %></p>
        <% if (!readOnly) { %><a class="button small" href="/edit/<%= encodePath(note.path) %>">打开编辑器修复</a><% } %>
      </section>
      <pre class="note-raw"><%= /^[\r\n]/.test(note.raw) ? '\n' : '' %><%= note.raw %></pre>
    <% } else { %>
      <div class="prose" data-note-hash="<%= note.hash %>"><%- html %></div>
    <% } %>
  </article>

  <% if (hasSidebar) { %>
    <aside id="note-navigation" tabindex="-1" class="note-links" data-note-sidebar aria-label="笔记导航">
      <div class="note-sidebar-tabs" role="tablist" aria-label="笔记侧栏">
        <button id="note-tab-outline" type="button" role="tab" data-note-tab="outline" aria-controls="note-panel-outline" aria-selected="<%= sidebarView === 'outline' %>" tabindex="<%= sidebarView === 'outline' ? '0' : '-1' %>">目录</button>
        <button id="note-tab-backlinks" type="button" role="tab" data-note-tab="backlinks" aria-controls="note-panel-backlinks" aria-selected="<%= sidebarView === 'backlinks' %>" tabindex="<%= sidebarView === 'backlinks' ? '0' : '-1' %>">反向链接<% if (backlinks.length) { %><span class="note-sidebar-count"><%= backlinks.length %></span><% } %></button>
      </div>
      <div id="note-panel-outline" class="note-sidebar-panel" role="tabpanel" aria-labelledby="note-tab-outline" tabindex="0" data-note-panel="outline"<% if (sidebarView !== 'outline') { %> hidden<% } %>>
        <% if (outline.length) { %>
          <nav class="note-outline" aria-label="正文目录"><%- include('partials/note-outline', { entries: outline }) %></nav>
        <% } else { %><p class="note-links-empty">暂无标题</p><% } %>
      </div>
      <div id="note-panel-backlinks" class="note-sidebar-panel" role="tabpanel" aria-labelledby="note-tab-backlinks" tabindex="0" data-note-panel="backlinks"<% if (sidebarView !== 'backlinks') { %> hidden<% } %>>
        <% if (backlinks.length) { %>
          <ul class="notelist">
            <% backlinks.forEach(link => { %><li><a href="/note/<%= encodePath(link.path) %>"><%= link.title %></a></li><% }) %>
          </ul>
        <% } else { %><p class="note-links-empty">暂无反向链接</p><% } %>
      </div>
    </aside>
  <% } %>
</div>

<script src="/static/note-sidebar.js" defer></script>
<%- include('partials/foot') %>
