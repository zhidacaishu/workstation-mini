<%- include('partials/head') %>

<header class="page-head">
  <div>
    <h1><%= ui.sectionName(section) %></h1>
    <p class="page-meta"><%= notes.length %> 篇</p>
  </div>
</header>

<ul class="library-list">
  <% notes.forEach(note => { %>
    <li><a class="library-document" href="/note/<%= encodePath(note.path) %>">
      <span class="library-document-content"><strong><%= note.title %></strong></span>
      <span class="library-document-meta"><span class="path"><%= note.path %></span></span>
    </a></li>
  <% }) %>
</ul>

<%- include('partials/foot') %>
