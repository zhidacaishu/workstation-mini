<%- include('partials/head') %>

<% if (queue.length === 0) { %>
  <section class="panel empty-state review-empty">
    <h1>今天没有要复习的卡片</h1>
    <p>到期 <%= dueCount %> 张 · 新卡 <%= freshCount %> 张</p>
    <a class="button" href="/decks">查看卡组</a>
  </section>
<% } else { %>
  <section id="reviewer" class="reviewer" tabindex="-1" data-queue="<%= encodeURIComponent(JSON.stringify(queue)) %>">
    <h1 class="visually-hidden"><%= deck ? `复习 · ${deck}` : '复习' %></h1>
    <div class="review-progress">
      <div class="review-progress-row">
        <span>剩余 <strong id="review-remaining"><%= queue.length %></strong> 张</span>
        <span class="review-totals">到期 <%= dueCount %> 张 · 新卡 <%= freshCount %> 张<% if (deck) { %> · <a href="/review">全部卡组</a><% } %></span>
      </div>
      <div class="review-meter" aria-hidden="true"><span id="review-meter-fill"></span></div>
    </div>

    <article class="reviewcard">
      <div class="review-card-meta">
        <span id="review-deck" class="review-deck"></span>
      </div>
      <div class="review-front" id="review-front"></div>
      <div class="review-back" id="review-back" hidden></div>
    </article>

    <div class="review-actions">
      <button class="button primary review-reveal" id="review-reveal" type="button">显示答案 <kbd>空格</kbd></button>
      <div class="rating-row" id="review-ratings" hidden>
        <% ratings.forEach(rating => { %>
          <button class="rating is-<%= rating.rating %>" type="button" data-rating="<%= rating.rating %>" title="<%= rating.hint %>">
            <%= rating.label %><kbd><%= rating.key %></kbd>
          </button>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="review-done" class="panel empty-state review-done" tabindex="-1" hidden>
    <h2 id="review-done-title">这一轮复习完了</h2>
    <p id="review-summary" role="status" aria-live="polite" aria-atomic="true"></p>
    <p id="review-failures" class="review-retry" role="alert" hidden></p>
    <div class="actions">
      <a class="button" href="/decks">卡组</a>
      <a class="button primary" href="/review">再来一轮</a>
    </div>
  </section>

  <noscript>
    <p class="notice">复习界面需要 JavaScript。</p>
  </noscript>
<% } %>

<%- include('partials/foot') %>
