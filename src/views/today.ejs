<%- include('partials/head') %>
<%
  const date = snapshot.date;
  const attention = snapshot.attention || {};
  // 首页只放一个最该推进的项目：进行中优先，其次是计划中的。
  const featured = [...(attention.runningExperiments || []), ...(attention.plannedProjects || [])][0];
  const review = snapshot.review || {};
  const reviewCount = (review.due || 0) + (review.fresh || 0);
  const tasks = snapshot.tasks || {};
  const dueNow = tasks.dueNow || [];
  const topTasks = dueNow.slice(0, 5);
  const upcoming = tasks.upcoming || [];
  // 月历备注已经在计划页里，不再挤进「最近的笔记」。
  const recentNotes = (recent || []).filter(item => item.section !== 'calendar' && (!featured || item.path !== featured.path)).slice(0, 4);
  const traceOf = project => [
    ui.fieldText(project.data.dataset),
    ui.fieldText(project.data.params),
    project.data.seed !== undefined && project.data.seed !== null && project.data.seed !== '' ? `seed ${ui.fieldText(project.data.seed)}` : '',
    ui.fieldText(project.data.commit)
  ].filter(Boolean).join(' · ');
%>

<header class="desk-header">
  <h1><%= Number(date.slice(5, 7)) %> 月 <%= Number(date.slice(8, 10)) %> 日</h1>
  <span class="desk-weekday"><%= snapshot.weekday || '' %></span>
</header>

<nav class="desk-metrics" aria-label="今日概览">
  <a class="desk-metric" href="/plan?view=list&filter=all"><span class="desk-metric-label">待办</span><strong><%= tasks.open || 0 %></strong></a>
  <a class="desk-metric<%= tasks.overdue ? ' is-warn' : '' %>" href="/plan?view=list&filter=overdue"><span class="desk-metric-label">逾期</span><strong><%= tasks.overdue || 0 %></strong></a>
  <a class="desk-metric is-action" href="<%= reviewCount ? '/review' : '/decks' %>"><span class="desk-metric-label">今日复习</span><strong><%= reviewCount %></strong><% if (reviewCount) { %><span class="desk-metric-go" aria-hidden="true">开始 →</span><% } %></a>
</nav>

<% if (typeof onboarding !== 'undefined' && onboarding) { %>
  <%- include('partials/onboarding', { progress: onboarding, variant: 'today' }) %>
<% } %>

<div class="desk-layout">
  <div class="desk-main">
    <section class="panel desk-research" aria-labelledby="continue-title">
      <div class="section-head"><h2 id="continue-title">继续研究</h2><a href="/board/experiment">全部项目</a></div>
      <% if (featured) { const deadline = ui.toDateString(featured.data.deadline); const trace = traceOf(featured); %>
        <article class="research-entry is-featured">
          <div class="research-context">
            <span class="status-label is-<%= featured.status %>"><span class="status-mark" aria-hidden="true"></span><%= featured.statusLabel %></span>
            <% if (deadline) { %><span class="research-deadline<%= deadline < date ? ' is-overdue' : '' %>">截止 <%= ui.shortDate(deadline, date) %> · <%= ui.dueRelative(deadline, date) %></span><% } %>
          </div>
          <h3><a href="/note/<%= encodePath(featured.path) %>"><%= featured.title %></a></h3>
          <% if (featured.data.next) { %>
            <p class="research-next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg><span><%= ui.fieldText(featured.data.next) %></span></p>
          <% } %>
          <% if (trace) { %><p class="research-trace"><%= trace %></p><% } %>
        </article>
      <% } else { %>
        <div class="empty-state">
          <p>还没有进行中的研究项目。</p>
          <% if (!readOnly) { %><a class="button" href="/new?folder=experiments">新建项目</a><% } %>
        </div>
      <% } %>
    </section>

    <section class="desk-recent" aria-labelledby="recent-title">
      <div class="section-head"><h2 id="recent-title">最近的笔记</h2><a href="/search">全部笔记</a></div>
      <% if (recentNotes.length) { %>
        <ul class="desk-notes">
          <% recentNotes.forEach(item => { %>
            <li><a href="/note/<%= encodePath(item.path) %>"><span class="desk-note-title"><%= item.title %></span><span class="desk-note-meta"><%= ui.modifiedLabel(item.mtimeMs, date) %></span></a></li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="empty-state">
          <p>还没有笔记</p>
          <% if (!readOnly) { %><a class="button" href="/new">写第一篇笔记</a><% } %>
        </div>
      <% } %>
    </section>
  </div>

  <section class="panel desk-side" aria-labelledby="task-title">
    <div class="section-head"><h2 id="task-title">今天需要处理</h2><a href="/plan?view=list">全部计划</a></div>
    <% const taskRow = task => { const overdue = task.due && task.due < date; const dueToday = task.due === date; %>
          <li class="desk-task">
            <% if (!readOnly) { %>
              <form class="desk-task-form" action="/tasks/update" method="post" data-task-form data-task-quick>
                <input type="hidden" name="path" value="<%= task.path %>">
                <input type="hidden" name="line" value="<%= task.line %>">
                <input type="hidden" name="expectedHash" value="<%= task.hash %>">
                <input type="hidden" name="due" value="<%= task.due || '' %>">
                <input class="task-check" type="checkbox" name="done" data-task-toggle aria-label="完成：<%= task.title %>">
              </form>
            <% } else { %>
              <span class="task-check is-static" aria-hidden="true"></span>
            <% } %>
            <a class="desk-task-title" href="/note/<%= encodePath(task.path) %>#L<%= task.line %>" title="<%= task.noteTitle %>"><%= task.title %></a>
            <% if (task.due) { %><time class="due-tag<%= overdue ? ' is-overdue' : dueToday ? ' is-today' : '' %>" datetime="<%= task.due %>"><%= overdue ? `逾期 ${ui.shortDate(task.due, date)}` : dueToday ? '今天' : ui.shortDate(task.due, date) %></time><% } %>
          </li>
    <% } %>
    <% if (topTasks.length) { %>
      <ul class="desk-tasks">
        <% topTasks.forEach(taskRow) %>
      </ul>
      <% if (dueNow.length > topTasks.length) { %>
        <a class="desk-more" href="/plan?view=list">还有 <%= dueNow.length - topTasks.length %> 条 →</a>
      <% } %>
    <% } else { %>
      <p class="desk-quiet">今天没有到期的待办。</p>
      <% if (upcoming.length) { %>
        <h3 class="desk-sublabel">接下来</h3>
        <ul class="desk-tasks">
          <% upcoming.forEach(taskRow) %>
        </ul>
      <% } %>
    <% } %>
  </section>
</div>

<%- include('partials/foot') %>
