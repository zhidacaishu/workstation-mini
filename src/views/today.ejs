<%- include('partials/head') %>

<section class="hero">
  <span class="eyebrow">今日节奏</span>
  <h1>今日 <span class="muted today-date"><%= snapshot.date %> <%= snapshot.weekday || '' %></span></h1>
</section>

<%
  const headline = [];
  if (snapshot.review && (snapshot.review.due || snapshot.review.fresh)) headline.push('要复习 ' + ((snapshot.review.due || 0) + (snapshot.review.fresh || 0)) + ' 张卡');
  if (snapshot.tasks && snapshot.tasks.overdue) headline.push(snapshot.tasks.overdue + ' 条待办已逾期');
  if (snapshot.tasks && snapshot.tasks.dueToday) headline.push(snapshot.tasks.dueToday + ' 条今天到期');
  if (snapshot.deadlines && snapshot.deadlines.length) headline.push(snapshot.deadlines.length + ' 个近期截止日期');
%>
<p class="headline"><%= headline.length ? headline.join('；') + '。' : '今天没有到期的东西。' %></p>

<div class="statrow">
  <a class="stat stat-link" href="/review"><span class="stat-label">待复习</span><span class="stat-value"><%= (snapshot.review && snapshot.review.due || 0) + (snapshot.review && snapshot.review.fresh || 0) %><span class="stat-unit">张</span></span></a>
  <a class="stat stat-link" href="/tasks"><span class="stat-label">未完成待办</span><span class="stat-value <%= snapshot.tasks && snapshot.tasks.overdue ? 'is-overdue' : '' %>"><%= snapshot.tasks && snapshot.tasks.open || 0 %></span></a>
  <a class="stat stat-link" href="/deadlines"><span class="stat-label">临近截止</span><span class="stat-value"><%= snapshot.deadlines && snapshot.deadlines.length || 0 %></span></a>
  <a class="stat stat-link" href="/search"><span class="stat-label">笔记总数</span><span class="stat-value"><%= total %></span></a>
</div>

<div class="columns">
  <section class="col-main">
    <% if (snapshot.tasks && snapshot.tasks.top && snapshot.tasks.top.length) { %>
      <h2>待办 <a class="muted more" href="/tasks">全部</a></h2>
      <ul class="tasklist">
        <% snapshot.tasks.top.forEach(task => { %>
          <li><span class="task-box">☐</span><span class="task-title"><%= task.title %></span><%- include('partials/task-actions', { task }) %><% if (task.due) { %><span class="chip <%= task.due < snapshot.date ? 'overdue' : (task.due === snapshot.date ? 'due-today' : '') %>"><%= task.due < snapshot.date ? '逾期 ' : '' %><%= task.due %></span><% } %><a class="task-source muted" href="/note/<%= encodePath(task.path) %>"><%= task.noteTitle %></a></li>
        <% }) %>
      </ul>
    <% } %>

    <% if (snapshot.deadlines && snapshot.deadlines.length) { %>
      <h2>临近截止 <a class="muted more" href="/deadlines">时间轴</a></h2>
      <ul class="notelist">
        <% snapshot.deadlines.forEach(entry => { %><li><span class="chip <%= entry.overdue ? 'overdue' : '' %>"><%= entry.date %></span><a href="/note/<%= encodePath(entry.path) %>"><%= entry.label %></a><span class="muted"><%= entry.detail %></span></li><% }) %>
      </ul>
    <% } %>

    <% if (snapshot.review && (snapshot.review.due || snapshot.review.fresh)) { %>
      <h2>复习队列</h2>
      <p class="muted">今天有 <strong><%= snapshot.review.due || 0 %></strong> 张到期卡和 <strong><%= snapshot.review.fresh || 0 %></strong> 张新卡，完成后会记录到本地复习日志。</p>
    <% } %>
  </section>

  <aside class="col-side">
    <% const attention = snapshot.attention || {}; const planned = attention.plannedProjects || []; const running = attention.runningExperiments || []; %>
    <% if (planned.length || running.length) { %>
      <h2>研究行动</h2>
      <ul class="notelist">
        <% planned.forEach(item => { %><li><span class="chip">计划中</span><a href="/note/<%= encodePath(item.path) %>"><%= item.title %></a></li><% }) %>
        <% running.forEach(item => { %><li><span class="chip">进行中</span><a href="/note/<%= encodePath(item.path) %>"><%= item.title %></a></li><% }) %>
      </ul>
    <% } %>

    <% if (total === 0) { %><h2>vault 还是空的</h2><p class="muted">在 <code>notes/</code> 下建立 <code>.md</code> 文件<% if (!readOnly) { %>，或者直接<a href="/new">新建一篇</a><% } %>。</p><% } else if (recent && recent.length) { %>
      <h2>最近改动</h2><ul class="notelist"><% recent.forEach(note => { %><li><a href="/note/<%= encodePath(note.path) %>"><%= note.title %></a></li><% }) %></ul>
    <% } %>
  </aside>
</div>

<%- include('partials/foot') %>
