<%- include('partials/head') %>
<%
  const attention = snapshot.attention || {};
  const projects = [...(attention.runningExperiments || []), ...(attention.plannedProjects || [])].slice(0, 2);
  const review = snapshot.review || {};
  const reviewCount = (review.due || 0) + (review.fresh || 0);
  const tasks = snapshot.tasks || {};
  const upcoming = projectDeadlines;
  const sectionNames = { experiments: '研究项目', research: '研究笔记', calendar: '月历备注', learning: '学习笔记', reading: '阅读笔记', inbox: '收件箱' };
%>

<header class="desk-header">
  <div>
    <p class="desk-date"><%= snapshot.date.replaceAll('-', ' / ') %><span><%= snapshot.weekday || '' %></span></p>
    <h1>回到研究现场</h1>
  </div>
</header>

<div class="desk-layout">
  <div class="desk-main">
    <section class="desk-section" aria-labelledby="continue-title">
      <div class="desk-section-heading"><h2 id="continue-title">继续研究</h2><a href="/board/experiment">全部项目</a></div>
      <% if (projects.length) { %>
        <div class="research-stack">
          <% projects.forEach((project, index) => { %>
            <article class="research-entry<%= index === 0 ? ' is-featured' : '' %>">
              <div class="research-context"><span class="research-status<%= project.status === 'running' ? ' is-running' : '' %>"><%= project.statusLabel %></span><% if (project.data.dataset) { %><span><%= project.data.dataset %></span><% } %></div>
              <h3><a href="/note/<%= encodePath(project.path) %>"><%= project.title %></a></h3>
              <% if (project.data.next) { %><p class="research-next"><span>下一步</span><%= project.data.next %></p><% } %>
              <% if (index === 0) { %><a class="research-open" href="/note/<%= encodePath(project.path) %>">继续这个项目</a><% } %>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="desk-empty"><h3>暂无进行中的项目</h3><a class="button" href="/board/experiment">查看研究项目</a></div>
      <% } %>
    </section>

    <section class="desk-section" aria-labelledby="recent-title">
      <div class="desk-section-heading"><h2 id="recent-title">最近的笔记</h2><a href="/search">打开资料库</a></div>
      <% if (recent && recent.length) { %>
        <ul class="desk-notes">
          <% recent.filter(note => !projects.some(project => project.path === note.path)).slice(0, 3).forEach(note => { %>
            <li><a href="/note/<%= encodePath(note.path) %>"><span class="document-mark" aria-hidden="true"></span><span><strong><%= note.title %></strong><small><%= sectionNames[note.section] || note.section || '未分区' %></small></span></a></li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="desk-empty"><h3>还没有笔记</h3><% if (!readOnly) { %><a class="button" href="/new">写第一篇笔记</a><% } %></div>
      <% } %>
    </section>
  </div>

  <aside class="desk-side" aria-label="今日安排">
    <section class="desk-section" aria-labelledby="task-title">
      <div class="desk-section-heading"><h2 id="task-title">今天需要处理</h2><a href="/plan?view=list">全部计划</a></div>
      <% if (tasks.top && tasks.top.length) { %>
        <ul class="desk-tasks">
          <% tasks.top.slice(0, 4).forEach(task => { %>
            <li><div class="desk-task-title"><span class="task-box" aria-hidden="true">☐</span><a href="/note/<%= encodePath(task.path) %>"><%= task.title %></a></div><div class="desk-task-meta"><span><%= task.noteTitle %></span><% if (task.due) { %><time class="<%= task.due < snapshot.date ? 'is-overdue' : '' %>" datetime="<%= task.due %>"><%= task.due < snapshot.date ? '逾期 · ' : task.due === snapshot.date ? '今天 · ' : '' %><%= task.due.slice(5).replace('-', '/') %></time><% } else { %><span>未安排日期</span><% } %></div><% if (!readOnly) { %><details class="desk-task-edit"><summary>调整待办</summary><%- include('partials/task-actions', { task }) %></details><% } %></li>
          <% }) %>
        </ul>
      <% } else { %><p class="desk-quiet">没有待办</p><% } %>
    </section>

    <section class="desk-review" aria-labelledby="review-title">
      <div class="desk-section-heading"><h2 id="review-title">巩固所学</h2></div>
      <% if (reviewCount) { %><p><% if (review.due) { %><strong><%= review.due %> 张到期卡</strong><% if (review.fresh) { %>，另有 <%= review.fresh %> 张新卡<% } %>，等待复习。<% } else { %><strong><%= review.fresh %> 张新卡</strong>。<% } %></p><a class="button primary" href="/review">开始复习</a><% } else { %><p>暂无待复习卡片</p><a class="button" href="/decks">查看卡组</a><% } %>
    </section>

    <section class="desk-section" aria-labelledby="deadline-title">
      <div class="desk-section-heading"><h2 id="deadline-title">项目期限</h2><a href="/plan?view=calendar">月历</a></div>
      <% if (upcoming.length) { %><ul class="desk-deadlines"><% upcoming.slice(0, 4).forEach(entry => { %><li><time datetime="<%= entry.date %>" class="<%= entry.overdue ? 'is-overdue' : '' %>"><%= entry.date.slice(5).replace('-', '/') %><% if (entry.overdue) { %><small>已逾期</small><% } %></time><a href="/note/<%= encodePath(entry.path) %>"><%= entry.label %></a></li><% }) %></ul><% } else { %><p class="desk-quiet">近期没有截止事项。</p><% } %>
    </section>
  </aside>
</div>

<%- include('partials/foot') %>
