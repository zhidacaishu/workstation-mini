<%- include('partials/head') %>
<%
  const REASONS = {
    delete: { label: '已删除', detail: '删除前版本', css: 'is-deleted' },
    card: { label: '删卡前', detail: '删除卡片前的整份卡组', css: 'is-deleted' },
    abort: { label: '中止前', detail: '中止 Git 操作前的内容', css: 'is-kept' },
    conflict: { label: '冲突未采用', detail: '解决同步冲突时没采用的那一边', css: 'is-kept' }
  };
  const reasonOf = record => REASONS[record.reason] || { label: '版本', detail: '保存前版本', css: 'is-version' };
  const kindLabel = record => record.kind === 'draft' ? '草稿' : reasonOf(record).label;
  const kindClass = record => record.kind === 'draft' ? 'is-draft' : reasonOf(record).css;
  // 列表里绝大多数是普通的保存前版本：只给草稿、已删除、卡组挂标签，普通版本不再每行写一遍「版本」。
  // 没选中记录时列表铺满；选中后再分出预览栏。
%>
<header class="page-head">
  <h1>历史与草稿</h1>
  <% const filter = notePath || deckPath; if (filter) { %><p class="history-filter"><span class="chip" title="<%= filter %>"><%= filter %></span><a href="/history">查看全部</a></p><% } %>
</header>

<div class="history-layout<%= selected ? ' has-preview' : '' %>">
  <section class="panel history-records" aria-label="记录">
    <% if (!records.length) { %>
      <div class="empty-state"><p>还没有记录。修改或删除笔记时会自动保存旧版本。</p></div>
    <% } else { %>
      <ul class="history-list notelist">
        <% records.forEach(record => { const active = selected && selected.id === record.id; %>
          <li>
            <a href="/history?id=<%= encodeURIComponent(record.id) %><%= notePath ? '&path=' + encodeURIComponent(notePath) : '' %><%= deckPath ? '&deck=' + encodeURIComponent(deckPath) : '' %><%= page > 1 ? '&page=' + page : '' %>"<% if (active) { %> aria-current="true" class="is-active"<% } %>>
              <span class="history-title"><%= record.title %></span>
              <span class="history-meta"><% if (record.source === 'deck') { %><span class="history-kind is-deck">卡组</span><% } %><% if (kindClass(record) !== 'is-version') { %><span class="history-kind <%= kindClass(record) %>"><%= kindLabel(record) %></span><% } %><time datetime="<%= record.at %>"><%= ui.dateTimeLabel(record.at) %></time><span class="history-path" title="<%= record.path %>"><%= record.path %></span></span>
            </a>
          </li>
        <% }) %>
      </ul>
      <% if (page > 1 || hasMore) { %>
        <nav class="history-pager" aria-label="翻页">
          <% const pageHref = n => '/history?page=' + n + (notePath ? '&path=' + encodeURIComponent(notePath) : '') + (deckPath ? '&deck=' + encodeURIComponent(deckPath) : ''); %>
          <% if (page > 1) { %><a href="<%= pageHref(page - 1) %>">← 较新的记录</a><% } %>
          <span>共 <%= total %> 条</span>
          <% if (hasMore) { %><a href="<%= pageHref(page + 1) %>">更早的记录 →</a><% } %>
        </nav>
      <% } %>
    <% } %>
  </section>

  <% if (selected) { %>
    <section class="panel history-preview-panel" aria-labelledby="history-preview-title">
      <header class="history-preview-head">
        <div>
          <h2 id="history-preview-title"><%= selected.title %></h2>
          <p class="page-meta"><%= ui.dateTimeLabel(selected.at) %> · <%= selected.kind === 'draft' ? '未保存草稿' : reasonOf(selected).detail %> · <span class="history-path" title="<%= selected.path %>"><%= selected.path %></span></p>
        </div>
        <% if (!readOnly && selected.source === 'deck') { %>
          <% if (!expectedHash) { %><p class="notice is-warn">无法读取当前卡组，修复文件后请刷新预览。</p><% } else if (comparison.state !== 'same') { %>
          <form action="/history/restore-deck" method="post" data-confirm="这个版本将覆盖当前卡组文件。覆盖前的内容会先存进历史。" data-confirm-danger>
            <input type="hidden" name="expectedHash" value="<%= expectedHash %>">
            <input type="hidden" name="id" value="<%= selected.id %>">
            <button class="button primary" type="submit">恢复这个卡组版本</button>
          </form>
          <% } %>
        <% } else if (!readOnly) { %><a class="button<%= comparison.state === 'same' ? '' : ' primary' %>" href="/recover/<%= encodeURIComponent(selected.id) %>">载入编辑器</a><% } %>
      </header>
      <%
        const selfHref = view => '/history?id=' + encodeURIComponent(selected.id)
          + (notePath ? '&path=' + encodeURIComponent(notePath) : '') + (deckPath ? '&deck=' + encodeURIComponent(deckPath) : '')
          + (page > 1 ? '&page=' + page : '') + (view ? '&view=' + view : '');
      %>
      <% if (comparison.state === 'diff') { %>
        <div class="history-compare-bar">
          <nav class="segmented" aria-label="查看方式">
            <a href="<%= selfHref('') %>"<% if (!showFull) { %> aria-current="page"<% } %>>改动</a>
            <a href="<%= selfHref('full') %>"<% if (showFull) { %> aria-current="page"<% } %>>全文</a>
          </nav>
          <p class="history-compare-note"><%= comparison.draft ? '草稿相对现在的文件' : '从这个版本到现在' %>：<span class="diff-count is-add">＋<%= comparison.added %> 行</span><span class="diff-count is-del">－<%= comparison.removed %> 行</span></p>
        </div>
        <% if (!showFull) { %>
          <p class="history-compare-legend"><span class="diff-count is-del">－</span> <%= comparison.draft ? '当前文件原有' : '这个旧版本原有' %> · <span class="diff-count is-add">＋</span> <%= comparison.draft ? '草稿新增' : '当前文件新增' %></p>
        <% } %>
      <% } else if (comparison.state === 'same') { %>
        <p class="history-compare-note">和现在的内容完全一样。</p>
      <% } else if (comparison.state === 'line-endings') { %>
        <p class="history-compare-note">文字和现在一样，只差换行符（Windows 与 Mac 的换行写法，或末尾有没有空行）。</p>
      <% } else if (comparison.state === 'missing') { %>
        <p class="history-compare-note">这个文件现在不存在，下面是当时的全文。</p>
      <% } %>
      <% if (showFull) { %>
        <pre class="history-preview"><%= /^[\r\n]/.test(selected.raw) ? '\n' : '' %><%= selected.raw %></pre>
      <% } else { %>
        <div class="history-preview history-diff" role="group" aria-label="逐行改动">
          <% comparison.hunks.forEach(hunk => { %>
            <% if (hunk.type === 'skip') { %>
              <p class="diff-skip">没有变化的 <%= hunk.count %> 行</p>
            <% } else { hunk.rows.forEach(row => { %>
              <div class="diff-row is-<%= row.type %>"><span class="diff-no" aria-hidden="true"><%= row.fromLine ?? '' %></span><span class="diff-no" aria-hidden="true"><%= row.toLine ?? '' %></span><span class="diff-sign"><%= row.type === 'add' ? '+' : row.type === 'del' ? '−' : '' %></span><span class="diff-text"><%= row.text %></span></div>
            <% }) } %>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% } %>
</div>
<%- include('partials/foot') %>
