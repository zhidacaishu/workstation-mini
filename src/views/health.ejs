<%- include('partials/head') %>
<%
  const count = value => value == null ? '未知' : value;
  const needsGitRecovery = report.git.recoveryRequired || report.recovery.syncRecovery;
%>
<section class="hero"><span class="eyebrow">只读诊断</span><h1>资料库健康</h1><p class="muted">Markdown 是源文件，SQLite 是派生索引；如需手动删除重建，请先退出应用并确认源文件可读。</p></section>
<section class="card health-grid">
  <h2>资料源与索引</h2>
  <p>vault <strong><%= report.vault.exists ? '可用' : '不存在' %></strong>；notes/ <strong><%= report.vault.notesDirExists ? '可用' : '不存在' %></strong>。</p>
  <p>Markdown <strong><%= report.vault.noteFiles %></strong> 篇，索引 <strong><%= count(report.vault.indexedNotes) %></strong> 篇，差异 <strong><%= count(report.vault.indexLag) %></strong>。</p>
  <% if (report.index.fatal) { %>
    <p role="alert">索引错误：<%= report.index.fatal.reason %>（<%= report.index.fatal.code %>）</p>
  <% } %>
  <% if (report.index.statErrors.length) { %>
    <p role="alert">索引统计读取失败，笔记数或断链数未知；其余诊断仍可查看。</p>
  <% } %>
  <p>索引状态：<strong><%= report.index.phase %></strong>，失败 <strong><%= report.index.failureTotal %></strong> 项。</p>
</section>
<section class="card"><h2>恢复与同步</h2><p>本地历史/草稿 <strong><%= report.drafts.count + report.drafts.deletedNoteHistoryCount %></strong> 条；Git <strong><%= needsGitRecovery ? '需要恢复' : report.git.error ? '状态未知' : report.git.isRepository ? (report.git.dirty ? '有未提交改动' : '干净') : '不是仓库' %></strong>。</p><p>断链 <strong><%= count(report.links.brokenCount) %></strong> 个；复习日志坏行 <strong><%= report.reviews.malformedLines %></strong>，重复事件 <strong><%= report.reviews.duplicateEventIds %></strong>。</p></section>
<% if (needsGitRecovery) { %>
<section class="card" role="alert">
  <h2>Git 操作需要恢复</h2>
  <p>存在未完成的 Git 操作或未合并条目，请先处理冲突或恢复操作，再继续同步。</p>
  <% if (report.git.recoveryRequired) { %>
    <p>恢复标记：<%= report.git.recoveryRequired.markers.join('、') || '未合并索引' %>；未合并索引条目：<%= report.git.recoveryRequired.unmerged %>。</p>
  <% } %>
  <% if (report.recovery.syncRecovery) { %>
    <p>同步恢复状态：<%= report.recovery.syncRecovery.kind %>；冲突文件：<%= count(report.recovery.syncRecovery.unmergedCount) %>。</p>
  <% } %>
</section>
<% } %>
<% if (report.index.failures.length) { %><section class="card"><h2>索引失败项</h2><ul><% report.index.failures.forEach(item => { %><li><code><%= item.path %></code>：<%= item.reason %></li><% }) %></ul></section><% } %>
<%- include('partials/foot') %>
