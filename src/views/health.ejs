<%- include('partials/head') %>
<section class="hero">
  <h1>知识库体检</h1>
  <p class="muted">共 <%= report.total %> 篇。下面这些不是错误，是提醒。</p>
  <nav class="boardnav">
    <a class="chip" href="/graph">双链图谱</a>
    <a class="chip" href="/graph?type=prereq">知识依赖</a>
    <a class="chip active" href="/health" aria-current="page">体检</a>
  </nav>
</section>

<div class="statrow">
  <div class="stat"><span class="stat-label">孤岛笔记</span><span class="stat-value"><%= report.orphans.length %></span></div>
  <div class="stat"><span class="stat-label">只有壳没有肉</span><span class="stat-value"><%= report.stubs.length %></span></div>
  <div class="stat"><span class="stat-label">待建链接</span><span class="stat-value"><%= report.pending.length %></span></div>
  <div class="stat"><span class="stat-label">建议连接</span><span class="stat-value"><%= suggestions.length %></span></div>
</div>

<div class="columns">
  <section class="col-main">
    <% if (suggestions.length) { %>
      <h2>内容相近但还没连起来</h2>
      <p class="muted">按词法相似度算的——<strong>不是语义检索</strong>。
        真正的语义检索需要嵌入模型，那要么调外部 API 要么本地跑模型，这台机器都不合适。
        TF-IDF 纯本地、离线可用，对「这两篇是不是讲一回事」已经够用。</p>
      <ul class="notelist">
        <% suggestions.forEach(pair => { %>
          <li>
            <a href="/note/<%= encodePath(pair.a.path) %>"><%= pair.a.title %></a>
            <span class="muted">↔</span>
            <a href="/note/<%= encodePath(pair.b.path) %>"><%= pair.b.title %></a>
            <span class="chip"><%= (pair.score * 100).toFixed(0) %>%</span>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (report.stubs.length) { %>
      <h2>只有壳没有肉 <span class="count"><%= report.stubs.length %></span></h2>
      <ul class="notelist">
        <% report.stubs.slice(0, 20).forEach(note => { %>
          <li><a href="/note/<%= encodePath(note.path) %>"><%= note.title %></a><span class="muted"><%= note.length %> 字</span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <aside class="col-side">
    <% if (report.pending.length) { %>
      <h2>待建链接</h2>
      <p class="muted">被引用最多的排前面——这些是你反复想到、但还没写的东西。</p>
      <ul class="notelist">
        <% report.pending.forEach(row => { %>
          <li><a class="wikilink-missing" href="/new?path=<%= encodeURIComponent(row.target) %>"><%= row.target %></a><span class="chip"><%= row.count %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </aside>
</div>
<%- include('partials/foot') %>
