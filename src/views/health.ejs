<%- include('partials/head') %>
<%
  const count = value => value == null ? '未知' : value;
  // 数字用大字号；「状态未知」「干净」这类文字值换小一档（见 styles.css 的 .is-text）。
  const valueClass = value => typeof value === 'number' ? 'health-value' : 'health-value is-text';
  const needsGitRecovery = report.git.recoveryRequired || report.recovery.syncRecovery;
  // 没开同步时，Git 不在、资料库不是仓库、探测不到，都不影响使用，不算需要留意的事。
  const syncOn = report.sync.enabled;
  const gitUnknown = Boolean(report.git.error || report.git.gitMissing);
  const gitLabel = needsGitRecovery ? '需要恢复'
    : !syncOn && (gitUnknown || !report.git.isRepository) ? '未启用'
    : report.git.gitMissing ? '没有安装'
    : report.git.error ? '状态未知'
    : report.git.isRepository ? (report.git.dirty ? '有未提交改动' : '干净') : '不是仓库';
  const gitWarn = Boolean(needsGitRecovery || (syncOn && (gitUnknown || !report.git.isRepository)));
  const gitHint = needsGitRecovery ? ''
    : !syncOn ? (report.git.isRepository ? '同步已关闭' : '同步已关闭，不影响本机使用')
    : report.git.gitMissing ? '同步需要先安装 Git'
    : report.git.error ? '这次没有读到 Git 状态，稍后刷新再看'
    : !report.git.isRepository ? '同步已开启，但资料库还不是 Git 仓库'
    : report.git.upstream ? (report.git.ahead || report.git.behind ? `本机领先 ${report.git.ahead}，落后 ${report.git.behind}` : '和远端一致') : '还没有关联远端分支';
  const indexWarn = Boolean(report.index.fatal || report.index.failureTotal || report.index.statErrors.length || (report.vault.indexLag && report.vault.indexLag !== 0));
  const linkWarn = Boolean(report.links.brokenCount);
  const reviewWarn = Boolean(report.reviews.malformedLines || report.reviews.duplicateEventIds || report.reviews.deckScanFailed || report.reviews.deckFailures.length);
  const vaultWarn = !report.vault.exists || !report.vault.notesDirExists;
  const issues = [vaultWarn, indexWarn, gitWarn, linkWarn, reviewWarn].filter(Boolean).length;
%>
<header class="page-head">
  <div>
    <h1>资料库健康</h1>
    <p class="page-meta">只读诊断</p>
  </div>
  <p class="health-summary<%= issues ? ' is-warn' : ' is-ok' %>"><span class="status-mark" aria-hidden="true"></span><%= issues ? `${issues} 项需要留意` : '一切正常' %></p>
</header>

<% if (report.index.fatal) { %>
  <p class="notice is-warn" role="alert">索引错误：<%= report.index.fatal.reason %>（<%= report.index.fatal.code %>）</p>
<% } %>
<% if (report.index.statErrors.length) { %>
  <p class="notice is-warn" role="alert">索引统计读取失败，笔记数或断链数未知；其余诊断仍可查看。</p>
<% } %>

<div class="health-grid">
  <section class="health-tile<%= vaultWarn ? ' is-warn' : '' %>">
    <h2>资料源</h2>
    <p class="<%= valueClass(report.vault.noteFiles) %>"><strong><%= report.vault.noteFiles %></strong> 篇 Markdown</p>
    <p class="health-detail">vault <strong><%= report.vault.exists ? '可用' : '不存在' %></strong> · notes/ <strong><%= report.vault.notesDirExists ? '可用' : '不存在' %></strong></p>
  </section>
  <section class="health-tile<%= indexWarn ? ' is-warn' : '' %>">
    <h2>索引</h2>
    <p class="<%= valueClass(report.vault.indexedNotes) %>"><strong><%= count(report.vault.indexedNotes) %></strong> 篇已索引</p>
    <p class="health-detail">状态 <strong><%= report.index.phase %></strong> · 差异 <strong><%= count(report.vault.indexLag) %></strong> · 失败 <strong><%= report.index.failureTotal %></strong> 项</p>
  </section>
  <section class="health-tile<%= gitWarn ? ' is-warn' : '' %>">
    <h2>版本控制</h2>
    <p class="health-value is-text">Git <strong><%= gitLabel %></strong></p>
    <p class="health-detail"><% if (gitHint) { %><%= gitHint %> · <% } %>本地历史与草稿 <strong><%= report.drafts.historyCount %></strong> 条</p>
  </section>
  <section class="health-tile<%= linkWarn ? ' is-warn' : '' %>">
    <h2>双链</h2>
    <p class="<%= valueClass(report.links.brokenCount) %>"><strong><%= count(report.links.brokenCount) %></strong> 个断链</p>
    <% if (report.links.broken.length) { %><p class="health-detail"><a href="#broken-links">看是哪些 ↓</a></p><% } %>
  </section>
  <section class="health-tile<%= reviewWarn ? ' is-warn' : '' %>">
    <h2>复习日志</h2>
    <p class="<%= valueClass(report.reviews.malformedLines) %>"><strong><%= report.reviews.malformedLines %></strong> 行损坏</p>
    <p class="health-detail">重复事件 <strong><%= report.reviews.duplicateEventIds %></strong></p>
  </section>
</div>

<% if (report.reviews.deckScanFailed) { %>
  <p class="notice is-warn" role="alert">卡组扫描未完成。请检查资料库中的 cards/ 目录及其子目录是否可以读取。</p>
<% } %>
<% if (report.reviews.deckFailures.length) { %>
  <section class="panel health-failures"><h2>无法读取的卡组</h2><ul>
    <% report.reviews.deckFailures.forEach(file => { %><li><code><%= file %></code><a href="/history?deck=<%= encodeURIComponent(file) %>">查看卡组历史</a></li><% }) %>
  </ul></section>
<% } %>
<% if (needsGitRecovery) { %>
<section class="notice is-warn" role="alert">
  <strong>Git 操作需要恢复</strong>
  <p>同步停在了一处冲突上：两台设备改了同一个文件。打开「设置 → Git 同步」，可以逐个文件选保留远端还是本机的版本，也可以中止这次操作；处理完同步会自己继续。</p>
  <% if (report.git.recoveryRequired) { %>
    <p>恢复标记：<%= report.git.recoveryRequired.markers.join('、') || '未合并索引' %>；未合并索引条目：<%= report.git.recoveryRequired.unmerged %>。</p>
  <% } %>
  <% if (report.recovery.syncRecovery) { %>
    <p>同步恢复状态：<%= report.recovery.syncRecovery.kind %>；冲突文件：<%= count(report.recovery.syncRecovery.unmergedCount) %>。</p>
  <% } %>
</section>
<% } %>
<% if (report.links.broken.length) { %>
  <section class="panel health-links" id="broken-links" aria-labelledby="broken-links-title">
    <h2 id="broken-links-title">断链</h2>
    <p class="health-detail">这些 <code>[[链接]]</code> 指向的笔记还不存在。写错了就去改，本来就打算以后再写的可以不管。</p>
    <ul>
      <% report.links.broken.forEach(item => { %>
        <li>
          <a href="/note/<%= encodePath(item.path) %>" title="<%= item.path %>"><%= item.title || item.path %></a>
          <span class="health-link-target"><span aria-hidden="true">→</span> <code>[[<%= item.target %>]]</code></span>
        </li>
      <% }) %>
    </ul>
    <% if (report.links.brokenTruncated) { %><p class="health-detail">只列出前 <%= report.links.broken.length %> 条，共 <%= report.links.brokenCount %> 条。</p><% } %>
  </section>
<% } %>
<% if (report.index.failures.length) { %>
  <section class="panel health-failures"><h2>索引失败项</h2><ul><% report.index.failures.forEach(item => { %><li><code><%= item.path %></code><span><%= item.reason %></span></li><% }) %></ul></section>
<% } %>
<%- include('partials/foot') %>
