<%- include('partials/head') %>

<section class="hero">
  <span class="eyebrow">研究输入</span>
  <h1>文献</h1>
  <p class="muted">Zotero 题录与标注、journal-tracker 的待读队列，以及已有剪藏笔记汇到一处。</p>
</section>

<div class="columns">
  <section class="col-main">
    <div class="section-heading library-heading">
      <div>
        <h2>Zotero
          <% if (annotationTotal) { %><span class="count"><%= annotationTotal %> 条标注</span><% } %>
          <% if (pdfTotal) { %><span class="count"><%= pdfTotal %> 个 PDF</span><% } %>
        </h2>
      </div>
      <a class="button small" href="/library/pdfs/search">搜索 PDF 全文<% if (pdfReadyTotal) { %>（<%= pdfReadyTotal %>）<% } %></a>
    </div>

    <% if (zoteroStatus) { %>
      <p class="muted integration-status"><%= zoteroStatus %>。
        Zotero 需要在本机运行；数据目录可在应用设置中选择。</p>
    <% } %>
    <% if (annotationStatus) { %>
      <p class="muted integration-status">标注：<%= annotationStatus %></p>
      <p class="muted">题录走官方本地 API，标注只能读 <code>zotero.sqlite</code> 的副本——
        官方本地 API 目前还不支持标注。</p>
    <% } %>

    <% if (zoteroItems.length === 0 && !zoteroStatus) { %>
      <p class="muted">Zotero 库里还没有条目。</p>
    <% } %>

    <ul class="literature-list">
      <% zoteroItems.forEach(item => { %>
        <li class="literature-entry" data-literature-item data-key="<%= item.key %>" data-note-path="<%= item.notePath %>" data-note-hash="<%= item.noteHash %>">
          <div class="literature-heading">
            <span class="lit-title"><%= item.title %></span>
            <% if (item.year) { %><span class="chip"><%= item.year %></span><% } %>
            <% if (item.annotationCount) { %><span class="chip"><%= item.annotationCount %> 条 Zotero 标注</span><% } %>
            <% if (item.standalone) { %><span class="chip">独立 PDF 附件</span><% } %>
            <% if (item.hasNote) { %>
              <a class="chip" href="/note/<%= encodePath(item.notePath) %>">已有笔记</a>
              <span class="chip<%= item.pendingCount ? ' due-today' : '' %>" data-pending-count><%= item.pendingCount %> 条待加工</span>
              <% if (!readOnly) { %><button type="button" class="button small" data-sync-lit="<%= item.key %>">同步标注</button><% } %>
            <% } else if (!readOnly && item.canCreateNote) { %>
              <button type="button" class="button small" data-make-lit="<%= item.key %>">建文献笔记</button>
            <% } %>
          </div>
          <% if (item.creators.length) { %><p class="muted literature-creators"><%= item.creators.slice(0, 3).join('；') %></p><% } %>

          <% if (item.pdfs.length) { %>
            <ul class="pdf-attachment-list" aria-label="<%= item.title %>的 PDF 附件">
              <% item.pdfs.forEach(pdf => { %>
                <li class="pdf-attachment" data-pdf-row data-document-id="<%= pdf.documentId %>" data-pdf-state="<%= pdf.state %>">
                  <div class="pdf-attachment-main">
                    <span class="pdf-file-name"><%= pdf.fileName %></span>
                    <% if (pdf.sizeLabel) { %><span class="muted pdf-size"><%= pdf.sizeLabel %></span><% } %>
                    <span class="chip pdf-state pdf-state-<%= pdf.state %>" data-pdf-status><%= pdf.stateLabel %></span>
                    <span class="muted pdf-progress" data-pdf-progress<%= pdf.progressLabel ? '' : ' hidden' %>><%= pdf.progressLabel %></span>
                  </div>
                  <div class="pdf-attachment-actions">
                    <% if (pdf.state === 'ready') { %>
                      <a class="button small" data-pdf-preview href="/library/pdfs/<%= pdf.documentId %>">查看正文<% if (pdf.pageCount) { %>（<%= pdf.pageCount %> 页）<% } %></a>
                    <% } %>
                    <% if (!readOnly && !pdf.active && pdf.state !== 'ready' && pdf.localAvailable && pdf.tokenConfigured) { %>
                      <button type="button" class="button small<%= pdf.state === 'failed' ? '' : ' primary' %>" data-parse-pdf
                              data-library-id="<%= pdf.libraryId %>"
                              data-attachment-key="<%= pdf.attachmentKey %>"
                              data-document-id="<%= pdf.documentId %>"
                              data-file-name="<%= pdf.fileName %>"
                              data-literature-title="<%= item.title %>"><%= pdf.state === 'failed' ? '重试解析' : '解析 PDF' %></button>
                    <% } %>
                  </div>
                  <p class="pdf-message<%= pdf.error || !pdf.localAvailable || (!pdf.tokenConfigured && pdf.state !== 'ready') ? '' : ' muted' %>" data-pdf-message<%= pdf.error || !pdf.localAvailable || (!pdf.tokenConfigured && pdf.state !== 'ready') ? '' : ' hidden' %>><%= pdf.error || pdf.unavailableReason || (!pdf.tokenConfigured && pdf.state !== 'ready' ? '请先在应用设置中配置 MinerU API Token。' : '') %></p>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <% if (item.hasNote && item.pendingAnnotations.length) { %>
            <ul class="annotation-list" data-pending-list aria-label="<%= item.title %>的待加工标注">
              <% item.pendingAnnotations.forEach(annotation => { %>
                <li data-annotation-row>
                  <div>
                    <p class="annotation-text"><%= annotation.text %></p>
                    <% if (annotation.comment) { %><p class="muted annotation-comment"><%= annotation.comment %></p><% } %>
                  </div>
                  <% if (annotation.page) { %><span class="chip">p.<%= annotation.page %></span><% } %>
                  <% if (!readOnly) { %>
                    <button type="button" class="button small" data-process-annotation
                            data-annotation-id="<%= annotation.id %>"
                            data-note-path="<%= annotation.notePath %>"
                            data-note-hash="<%= annotation.hash %>"
                            data-text="<%= annotation.text %>"
                            data-comment="<%= annotation.comment %>"
                            data-page="<%= annotation.page %>">加工…</button>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </li>
      <% }) %>
    </ul>

    <h2>待读论文</h2>
    <% if (papersStatus) { %>
      <p class="muted integration-status"><%= papersStatus %>。
        可在应用设置中填写 journal-tracker 地址、邮箱和密码。</p>
    <% } %>
    <% if (papers.length === 0 && !papersStatus) { %>
      <p class="muted">待读队列是空的。</p>
    <% } %>
    <ul class="notelist">
      <% papers.forEach(paper => { %>
        <li>
          <% if (paper.url) { %><a href="<%= paper.url %>" target="_blank" rel="noopener noreferrer"><%= paper.title %></a>
          <% } else { %><span><%= paper.title %></span><% } %>
          <% if (paper.journal) { %><span class="chip"><%= paper.journal %></span><% } %>
          <% if (Number.isFinite(paper.score)) { %><span class="chip">相关度 <%= paper.score.toFixed(2) %></span><% } %>
        </li>
      <% }) %>
    </ul>
  </section>

  <aside class="col-side">
    <h2>已有剪藏</h2>
    <p class="muted">现有 <code>notes/clips</code> 内容会继续保留、搜索和浏览；新的网页捕获将在后续浏览器扩展中提供。</p>

    <% if (clips.length) { %>
      <h2>最近剪藏 <span class="count"><%= clips.length %></span></h2>
      <ul class="notelist">
        <% clips.forEach(clip => { %>
          <li>
            <a href="/note/<%= encodePath(clip.path) %>"><%= clip.title %></a>
            <% if (clip.status === 'unread') { %><span class="chip">未读</span><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </aside>
</div>

<% if (!readOnly) { %>
  <dialog class="annotation-dialog pdf-confirm-dialog" data-pdf-dialog aria-labelledby="pdf-dialog-title">
    <div class="pdf-confirm-content">
      <div class="dialog-heading">
        <div><span class="eyebrow">外部 PDF 解析</span><h2 id="pdf-dialog-title">确认上传这份 PDF</h2></div>
        <button type="button" class="button quiet" data-pdf-dialog-close aria-label="关闭">关闭</button>
      </div>
      <p><strong data-pdf-dialog-file></strong></p>
      <p class="muted" data-pdf-dialog-title-text></p>
      <div class="integration-status pdf-privacy-notice">
        <p>确认后，这一份 Zotero PDF 会上传至 MinerU 精确解析 API。MinerU 将接收论文全文；服务限制为单篇最多 200 MB / 200 页。</p>
        <p>完成后的 Markdown 和正文索引会保存到资料库，并可能通过已启用的 Git 同步传到你的远端仓库；工作台不会保留上传用的 PDF 副本或结果 ZIP。</p>
      </div>
      <p class="annotation-status muted" data-pdf-dialog-status role="status" aria-live="polite">只有点击“确认上传并解析”才会开始。</p>
      <div class="actions dialog-actions">
        <button type="button" class="button" data-pdf-dialog-cancel>取消</button>
        <button type="button" class="button primary" data-pdf-dialog-submit>确认上传并解析</button>
      </div>
    </div>
  </dialog>

  <dialog class="annotation-dialog" data-annotation-dialog aria-labelledby="annotation-dialog-title">
    <form data-annotation-form>
      <div class="dialog-heading">
        <div><span class="eyebrow">文献标注</span><h2 id="annotation-dialog-title">加工这条标注</h2></div>
        <button type="button" class="button quiet" data-dialog-close aria-label="关闭">关闭</button>
      </div>
      <blockquote class="annotation-source" data-annotation-source></blockquote>
      <p class="muted" data-annotation-comment hidden></p>

      <fieldset class="annotation-output">
        <legend><label><input type="checkbox" data-output-toggle="note"> 生成永久笔记</label></legend>
        <div class="annotation-fields" data-output-fields="note" hidden>
          <label>标题<input name="noteTitle" maxlength="200" required></label>
          <label>正文<textarea name="noteBody" rows="5" maxlength="20000" required></textarea></label>
        </div>
      </fieldset>

      <fieldset class="annotation-output">
        <legend><label><input type="checkbox" data-output-toggle="card"> 生成复习卡</label></legend>
        <div class="annotation-fields" data-output-fields="card" hidden>
          <label>卡组<input name="cardDeck" value="inbox" maxlength="100" required></label>
          <label>正面<textarea name="cardFront" rows="2" maxlength="500" required></textarea></label>
          <label>背面<textarea name="cardBack" rows="4" maxlength="10000" required></textarea></label>
        </div>
      </fieldset>

      <fieldset class="annotation-output">
        <legend><label><input type="checkbox" data-output-toggle="task"> 生成 Markdown 待办</label></legend>
        <div class="annotation-fields" data-output-fields="task" hidden>
          <label>待办内容<input name="taskTitle" maxlength="500" required></label>
        </div>
      </fieldset>

      <p class="annotation-status muted" data-annotation-status role="status" aria-live="polite">未选择输出时，仅将标注记为已处理。</p>
      <div class="actions dialog-actions">
        <button type="button" class="button" data-dialog-cancel>取消</button>
        <button type="submit" class="button primary" data-dialog-submit>仅标记已处理</button>
      </div>
    </form>
  </dialog>
<% } %>

<script src="/static/library.js" defer></script>

<%- include('partials/foot') %>
