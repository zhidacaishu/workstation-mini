<% if (!readOnly) { %>
  <form class="task-actions" action="/tasks/update" method="post" data-task-form>
    <input type="hidden" name="path" value="<%= task.path %>">
    <input type="hidden" name="line" value="<%= task.line %>">
    <input type="hidden" name="expectedHash" value="<%= task.hash %>">
    <label><input type="checkbox" name="done" <%= task.done ? 'checked' : '' %>>完成</label>
    <label>日期 <input type="date" name="due" value="<%= task.due || '' %>" aria-label="<%= task.title %>的日期"></label>
    <button type="submit" class="button quiet">更新</button>
  </form>
<% } %>
