<%
  const icons = {
    today: '<path d="m3 10 9-7 9 7v10H3Z"/><path d="M9 20v-7h6v7"/>',
    notes: '<path d="M6 3h9l4 4v14H6Z"/><path d="M14 3v5h5M9 12h7M9 16h5"/>',
    projects: '<path d="M9 3h6M10 3v6l-6 10a1 1 0 0 0 1 2h14a1 1 0 0 0 1-2L14 9V3"/><path d="M8 15h8"/>',
    plan: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 11h18M8 15h2M14 15h2"/>',
    review: '<rect x="5" y="7" width="15" height="14" rx="2"/><path d="M3 16V4a1 1 0 0 1 1-1h12M10 14l2 2 4-4"/>',
    history: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    health: '<path d="M3 12h4l2-5 4 10 2-5h6"/>'
  };
%>
<nav class="workspace-nav" aria-label="主导航">
  <% navItems.forEach(item => { %>
    <a class="workspace-nav-link<%= item.active ? ' is-active' : '' %>" href="<%= item.href %>"<% if (item.active) { %> aria-current="page"<% } %>>
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icons[item.key] %></svg>
      <span><%= item.label %></span>
      <% if (item.badge > 0) { %><span class="nav-badge<%= item.badgeTone === 'warn' ? ' is-warn' : '' %>" title="<%= item.badge %> <%= item.badgeLabel %>"><span class="visually-hidden">，</span><%= item.badge > 99 ? '99+' : item.badge %><span class="visually-hidden"> <%= item.badgeLabel %></span></span><% } %>
    </a>
  <% }) %>
</nav>

<nav class="workspace-tools" aria-label="资料库工具">
  <% toolItems.forEach(item => { %>
    <a class="workspace-tool-link<%= item.active ? ' is-active' : '' %>" href="<%= item.href %>" title="<%= item.label %>"<% if (item.active) { %> aria-current="page"<% } %>>
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icons[item.key] %></svg>
      <span class="visually-hidden"><%= item.label %></span>
    </a>
  <% }) %>
</nav>
