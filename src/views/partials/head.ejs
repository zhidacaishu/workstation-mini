<%
  const routePath = typeof currentPath === 'string' ? currentPath : '/';
  const matches = (...prefixes) => prefixes.some(prefix => (
    prefix === '/' ? routePath === '/' : routePath === prefix || routePath.startsWith(`${prefix}/`)
  ));
  const counts = typeof navCounts === 'object' && navCounts ? navCounts : { overdue: 0, review: 0 };
  const navItems = [
    { key: 'today', label: '今日', href: '/', active: matches('/') },
    { key: 'notes', label: '笔记', href: '/search', active: matches('/search', '/note', '/edit', '/new') },
    { key: 'projects', label: '研究项目', href: '/board/experiment', active: matches('/board') },
    { key: 'plan', label: '计划', href: '/plan', active: matches('/plan', '/tasks', '/calendar', '/deadlines'), badge: counts.overdue, badgeTone: 'warn', badgeLabel: '项逾期' },
    { key: 'review', label: '复习', href: '/decks', active: matches('/decks', '/review'), badge: counts.review, badgeLabel: '张到期' }
  ];
  const toolItems = [
    { key: 'history', label: '历史与草稿', href: '/history', active: matches('/history', '/recover') },
    { key: 'health', label: '资料库健康', href: '/health', active: matches('/health') }
  ];
  // isMac 由 src/app.js 注入。前端按 data-primary-modifier 决定认哪个修饰键，
  // 提示文案也跟着走 —— macOS 上写「Ctrl K」既是错的，也和实际能用的键不符。
  const onMac = typeof isMac !== 'undefined' && isMac;
  const primaryModifier = onMac ? 'meta' : 'control';
  const paletteHint = onMac ? '⌘K' : 'Ctrl K';
  const pageMode = matches('/review', '/edit', '/new')
      ? 'page-focus'
      : matches('/note')
        ? 'page-reading'
        // 计划页的列表和月历用同一个容器宽度，「列表 / 月历」切换钮切换时不会移位。
        : matches('/board', '/plan', '/tasks', '/calendar', '/deadlines') ? 'page-canvas' : 'page-work';
%>
<!doctype html>
<html lang="zh-CN"<% if (typeof insetChrome !== 'undefined' && insetChrome) { %> class="chrome-inset"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · 科研工作台</title>
  <link rel="stylesheet" href="/static/fonts/geist/wght.css">
  <link rel="stylesheet" href="/static/fonts/geist-mono/wght.css">
  <link rel="stylesheet" href="/static/fonts/noto-sans-sc/wght.css">
  <link rel="stylesheet" href="/static/katex/katex.min.css">
  <%# 颜色、字号、圆角等变量，主窗口、设置和恢复窗口共用这一份。 %>
  <link rel="stylesheet" href="/static/tokens.css">
  <link rel="stylesheet" href="/static/styles.css">
  <%# 新建笔记的标题与路径要在草稿和编辑器记下初始状态之前就位，所以排在最前面。 %>
  <% if (typeof isNew !== 'undefined' && isNew) { %><script src="/static/new-note.js" defer></script><% } %>
  <script src="/static/transition-guard.js"></script>
  <script src="/static/drafts.js" defer></script>
  <script src="/static/task-actions.js" defer></script>
  <script src="/static/app.js" defer></script>
  <script src="/static/palette.js" defer></script>
  <script src="/static/guide.js" defer></script>
  <script src="/static/review.js" defer></script>
  <% if (!readOnly) { %><script src="/static/editor.js" defer></script><% } %>
  <% if (!readOnly) { %><script src="/static/selection-card.js" defer></script><% } %>
</head>
<body class="<%= pageMode %><%= readOnly ? ' is-readonly' : '' %>" data-page-path="<%= routePath %>" data-primary-modifier="<%= primaryModifier %>"<% if (typeof note !== 'undefined' && note) { %> data-note-path="<%= note.path %>"<% } %>>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <div class="app-shell">
    <aside class="workspace-sidebar" aria-label="应用导航">
      <a class="workspace-brand" href="/" aria-label="科研工作台首页" title="科研工作台">
        <svg class="workspace-mark" viewBox="163 172 680 680" aria-hidden="true">
          <rect class="workspace-mark-back" x="225" y="176" width="440" height="560" rx="72" transform="rotate(22 297 664)"/>
          <rect class="workspace-mark-front" x="225" y="176" width="440" height="560" rx="72"/>
          <path class="workspace-mark-tick" d="M327 462 L417 552 L581 368"/>
        </svg>
      </a>

      <button type="button" class="palette-trigger workspace-search" data-palette-open aria-haspopup="dialog" aria-controls="palette" aria-keyshortcuts="<%= onMac ? 'Meta+K' : 'Control+K' %>" title="搜索与命令（<%= paletteHint %>）">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>搜索</span>
      </button>

      <%- include('navigation', { navItems, toolItems }) %>

      <div class="workspace-sidebar-bottom">
        <% const icons = ui.NAV_ICONS || {}; %>
        <nav class="workspace-tools" aria-label="资料库工具">
          <% toolItems.forEach(item => { %>
            <a data-nav="<%= item.key %>" class="workspace-tool-link<%= item.active ? ' is-active' : '' %>" href="<%= item.href %>" title="<%= item.label %>"<% if (item.active) { %> aria-current="page"<% } %>>
              <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icons[item.key] %></svg>
              <span class="visually-hidden"><%= item.label %></span>
            </a>
          <% }) %>
        </nav>
        <div class="workspace-sidebar-footer">
          <a data-nav="guide" class="workspace-tool-link guide-entry<%= matches('/guide') ? ' is-active' : '' %>" href="/guide" title="上手指南" aria-label="上手指南"<% if (matches('/guide')) { %> aria-current="page"<% } %>>
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 .5c0 1.5-2.5 2-2.5 3.5M12 16v1"/></svg>
          </a>
          <button type="button" class="workspace-tool-link guide-entry" data-desktop-settings title="设置" aria-label="设置" hidden>
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3"/><circle cx="15" cy="17" r="3"/></svg>
          </button>
          <% if (readOnly) { %>
            <span class="readonly-status" title="可浏览、搜索和复习，不能修改笔记">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
              <span>只读</span>
            </span>
          <% } else { %>
            <a class="workspace-create" href="/new" aria-label="新建笔记" title="新建笔记">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </a>
          <% } %>
        </div>
      </div>
    </aside>

    <div class="workspace-main">
      <%# 建索引的进度每秒都在变，读屏软件不必逐条播报；失败项和结论才需要读出来。 %>
      <section class="index-banner" id="index-banner" hidden>
        <p class="index-banner-message" id="index-banner-message"></p>
        <ul class="index-banner-failures" id="index-banner-failures" hidden></ul>
        <p class="index-banner-summary" id="index-banner-summary" role="status" hidden></p>
        <button class="button small" id="index-banner-retry" type="button" hidden>重试失败项</button>
      </section>
      <main class="page <%= pageMode %>" id="main-content" tabindex="-1">
