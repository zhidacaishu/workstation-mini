<%
  const routePath = typeof currentPath === 'string' ? currentPath : '/';
  const matches = (...prefixes) => prefixes.some(prefix => (
    prefix === '/' ? routePath === '/' : routePath === prefix || routePath.startsWith(`${prefix}/`)
  ));
  const navGroups = [
    {
      label: '工作台',
      items: [
        { label: '今天', href: '/', active: matches('/') },
        { label: '知识', href: '/search', active: matches('/search', '/note', '/edit', '/new', '/section') },
        { label: '复习', href: '/review', active: matches('/review', '/decks') },
        { label: '练习与错题', href: '/mistakes', active: matches('/mistakes') },
        { label: '研究项目', href: '/board/experiment', active: matches('/board') }
      ]
    }
  ];
  const toolItems = [
    { label: '历史与草稿', href: '/history', active: matches('/history', '/recover') },
    { label: '待办', href: '/tasks', active: matches('/tasks') },
    { label: '截止日期', href: '/deadlines', active: matches('/deadlines') }
  ];
  const toolsActive = toolItems.some(item => item.active);
  // isMac 由 src/app.js 注入。前端按 data-primary-modifier 决定认哪个修饰键，
  // 提示文案也跟着走 —— macOS 上写「Ctrl K」既是错的，也和实际能用的键不符。
  const onMac = typeof isMac !== 'undefined' && isMac;
  const primaryModifier = onMac ? 'meta' : 'control';
  const paletteHint = onMac ? '\u2318K' : 'Ctrl K';
  const pageMode = matches('/board')
    ? 'page-canvas'
    : matches('/review', '/edit', '/new')
      ? 'page-focus'
      : matches('/note')
        ? 'page-reading'
        : 'page-work';
%>
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · 科研工作台</title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="/static/drafts.js" defer></script>
  <script src="/static/task-actions.js" defer></script>
  <script src="/static/app.js" defer></script>
  <script src="/static/palette.js" defer></script>
  <script src="/static/review.js" defer></script>
  <% if (!readOnly) { %><script src="/static/selection-card.js" defer></script><% } %>
  <% if (!readOnly) { %><script src="/static/attachments.js" defer></script><% } %>
</head>
<body class="<%= pageMode %><%= readOnly ? ' is-readonly' : '' %>" data-page-path="<%= routePath %>" data-primary-modifier="<%= primaryModifier %>"<% if (typeof note !== 'undefined' && note) { %> data-note-path="<%= note.path %>"<% } %>>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <dialog id="navigation-dialog" class="navigation-dialog" aria-labelledby="navigation-title">
    <div class="dialog-heading">
      <h2 id="navigation-title">前往工作区</h2>
      <button type="button" class="button small" data-navigation-close aria-label="关闭导航">关闭 <kbd>Esc</kbd></button>
    </div>
    <%- include('navigation', { navGroups, toolItems, toolsActive }) %>
    <div class="navigation-actions">
      <% if (!readOnly) { %><a class="button" href="/new">新建笔记</a>
      <% } else { %><span class="readonly-status">只读模式：可浏览、搜索和复习</span><% } %>
    </div>
  </dialog>
  <div class="app-shell">
    <aside class="workspace-sidebar">
      <a class="workspace-brand" href="/" aria-label="科研工作台首页">
        <span class="workspace-mark" aria-hidden="true">研</span>
        <span><strong>科研工作台</strong><small>Quiet research desk</small></span>
      </a>

      <%- include('navigation', { navGroups, toolItems, toolsActive }) %>
      <span class="compact-page-title"><%= title %></span>
      <button type="button" class="button small compact-nav-trigger" data-navigation-open aria-haspopup="dialog" aria-controls="navigation-dialog" aria-expanded="false">导航</button>

      <div class="workspace-sidebar-footer">
        <% if (!readOnly) { %>
          <a class="button workspace-create" href="/new">新建笔记 <span aria-hidden="true">＋</span></a>
        <% } else { %>
          <span class="readonly-status" title="可浏览、搜索和复习，不能修改笔记"><span aria-hidden="true"></span>只读模式</span>
        <% } %>
        <button type="button" class="palette-trigger sidebar-command" data-palette-open aria-label="打开命令面板" aria-haspopup="dialog" aria-controls="palette">
          <span>打开命令</span><kbd><%= paletteHint %></kbd>
        </button>
      </div>
    </aside>

    <div class="workspace-main">
      <header class="workspace-toolbar">
        <div class="workspace-context">
          <span>当前视图</span>
          <strong><%= title %></strong>
        </div>
        <form class="topsearch" action="/search" method="get" role="search">
          <span class="search-glyph" aria-hidden="true"></span>
          <input type="search" name="q" placeholder="搜索资料库…" value="<%= typeof query !== 'undefined' ? query : '' %>" aria-label="搜索笔记">
          <kbd>/</kbd>
        </form>
        <% if (readOnly) { %>
          <span class="readonly-status readonly-status-compact" title="可浏览、搜索和复习，不能修改笔记" aria-label="只读模式：可浏览、搜索和复习，不能修改笔记"><span aria-hidden="true"></span>只读</span>
        <% } %>
        <button type="button" class="palette-trigger toolbar-command" data-palette-open aria-label="打开命令面板" aria-haspopup="dialog" aria-controls="palette">
          <span>命令</span><kbd><%= paletteHint %></kbd>
        </button>
      </header>
      <section class="index-banner" id="index-banner" role="status" aria-live="polite" aria-atomic="false" hidden>
        <p class="index-banner-message" id="index-banner-message"></p>
        <ul class="index-banner-failures" id="index-banner-failures" hidden></ul>
        <p class="index-banner-summary" id="index-banner-summary" hidden></p>
        <button class="button small" id="index-banner-retry" type="button" hidden>重试失败项</button>
      </section>
      <main class="page <%= pageMode %>" id="main-content" tabindex="-1">
