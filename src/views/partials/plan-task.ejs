<li class="plan-task<%= task.done ? ' is-done' : '' %><%= !task.done && task.due && task.due < today ? ' is-overdue' : '' %>">
  <% if (readOnly) { %>
    <div class="plan-task-form"><span class="task-check is-static<%= task.done ? ' is-checked' : '' %>" role="img" aria-label="<%= task.done ? '已完成' : '未完成' %>"></span><div class="plan-task-content"><a href="/note/<%= encodePath(task.path) %>#L<%= task.line %>"><%- ui.inlineTitle(task.title) %></a><% if (task.noteTitle !== task.title) { %><span title="<%= task.noteTitle %>"><%= task.noteTitle %></span><% } %></div><% if (view !== 'calendar') { %><time class="plan-task-when" datetime="<%= task.due || '' %>" title="<%= task.due || '' %>"><%= task.due ? ui.dueLabel(task.due, today) : '' %></time><% } %></div>
  <% } else { %>
    <form class="plan-task-form" action="/tasks/update" method="post" data-task-form data-plan-task>
      <input type="hidden" name="path" value="<%= task.path %>">
      <input type="hidden" name="line" value="<%= task.line %>">
      <input type="hidden" name="expectedHash" value="<%= task.hash %>">
      <input type="hidden" name="returnTo" value="<%= view === 'calendar' ? '/plan?view=calendar&month=' + month + '&date=' + selected : '/plan?view=list&filter=' + filter %>">
      <input class="plan-checkbox task-check" type="checkbox" name="done"<% if (task.done) { %> checked<% } %> data-task-toggle aria-label="<%= task.done ? '重新打开' : '完成' %>：<%= task.title %>">
      <div class="plan-task-content"><a href="/note/<%= encodePath(task.path) %>#L<%= task.line %>"><%- ui.inlineTitle(task.title) %></a><% if (task.noteTitle !== task.title) { %><span title="<%= task.noteTitle %>"><%= task.noteTitle %></span><% } %></div>
      <%# 月历已有所选日期，行内只保留改期入口；列表仍显示短日期并支持直接编辑。 %>
      <% if (view === 'calendar') { %>
        <details class="plan-task-reschedule" name="task-reschedule">
          <summary aria-label="修改「<%= task.title %>」的到期日期" title="修改到期日期">改期</summary>
          <div class="plan-task-date-popover">
            <label>
              <span>到期日期</span>
              <input class="plan-task-date" type="date" name="due" value="<%= task.due || '' %>" aria-label="<%= task.title %>的到期日期">
            </label>
            <button class="button small primary" type="submit" data-task-save>保存</button>
          </div>
        </details>
      <% } else { %>
      <span class="plan-task-due">
        <time class="plan-task-when" datetime="<%= task.due || '' %>" aria-hidden="true"><%= task.due ? ui.dueLabel(task.due, today) : '' %></time>
        <input class="plan-task-date" type="date" name="due" value="<%= task.due || '' %>" aria-label="<%= task.title %>的到期日期" title="修改到期日期">
      </span>
      <button class="button small primary" type="submit" data-task-save>保存</button>
      <% } %>
    </form>
  <% } %>
</li>
