      </main>
    </div>
  </div>

  <dialog id="palette" class="palette" data-readonly="<%= readOnly ? '1' : '0' %>" aria-labelledby="palette-title">
    <div class="palette-heading">
      <div><span class="eyebrow">快速前往</span><h2 id="palette-title">搜索与命令</h2></div>
      <kbd>Esc</kbd>
    </div>
    <div class="palette-search">
      <span class="search-glyph" aria-hidden="true"></span>
      <input type="search" class="palette-input" placeholder="搜笔记，或输入命令…"
             autocomplete="off" spellcheck="false" aria-label="命令面板"
             role="combobox" aria-expanded="false"
             aria-controls="palette-results" aria-autocomplete="list">
    </div>
    <p class="palette-status" role="status" aria-live="polite"></p>
    <ul id="palette-results" class="palette-list" role="listbox" aria-label="搜索结果"></ul>
    <p class="palette-hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span><kbd>Enter</kbd> 打开</span><span><kbd>Esc</kbd> 关闭</span>
    </p>
  </dialog>

  <form id="palette-post" method="post" hidden></form>
  <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="true"></div>
</body>
</html>
