<%- include('partials/head') %>

<section class="hero">
  <span class="eyebrow">时间边界</span>
  <h1><%= grid.label %></h1>
  <p class="muted">按月查看截止、待办与复习负荷，选择日期安排时间块。</p>
  <nav class="boardnav calnav" aria-label="切换月份">
    <a class="chip" href="/calendar?month=<%= grid.prevMonth %>" rel="prev">← 上个月</a>
    <a class="chip <%= grid.month === grid.thisMonth ? 'active' : '' %>" href="/calendar">本月</a>
    <a class="chip" href="/calendar?month=<%= grid.nextMonth %>" rel="next">下个月 →</a>
    <a class="chip" href="/calendar.ics" download>导出 .ics</a>
  </nav>
</section>

<div class="statrow">
  <div class="stat">
    <span class="stat-label">本视图截止</span>
    <span class="stat-value"><%= grid.totals.entries %></span>
  </div>
  <a class="stat stat-link" href="/review">
    <span class="stat-label">待复习</span>
    <span class="stat-value"><%= grid.totals.reviewDue %></span>
    <span class="stat-unit">张</span>
  </a>
  <div class="stat">
    <span class="stat-label">已排时间块</span>
    <span class="stat-value" data-plan-total><%= grid.totals.plan %></span>
  </div>
  <% if (grid.backlog) { %>
    <a class="stat stat-link" href="/review">
      <span class="stat-label">积压</span>
      <span class="stat-value"><%= grid.backlog %></span>
      <span class="stat-unit">张</span>
    </a>
  <% } %>
</div>

<div class="columns callayout">
  <div class="col-main">
    <div class="calgrid" id="calendar" data-month="<%= grid.month %>" data-today="<%= grid.today %>">
      <div class="calgrid-head" aria-hidden="true">
        <% grid.weekdayHeaders.forEach(name => { %><span><%= name %></span><% }) %>
      </div>

      <div class="calgrid-body" aria-label="<%= grid.label %>">
        <% grid.weeks.forEach(week => { %>
          <% week.forEach(cell => { %>
            <%
              // 复习负荷的强度：相对整幅网格的最大值，翻月时基准一致，颜色才有可比性。
              //
              // 开方是因为分布天生是偏的：逾期的卡全堆在今天那一格，一个 30 能把
              // 其余每天 2、3 张的日子全压成同一片白。开方之后中段重新拉得开，
              // 而「哪天最重」的排序不变 —— 单调变换不会说谎，只是让差别看得见。
              const load = grid.peakReview > 0 ? Math.sqrt(cell.reviewDue / grid.peakReview) : 0;
              const classes = [
                'calday',
                cell.inMonth ? '' : 'is-outside',
                cell.isToday ? 'is-today' : '',
                cell.isWeekend ? 'is-weekend' : '',
                cell.date === detail.date ? 'is-selected' : ''
              ].filter(Boolean).join(' ');
            %>
            <a class="<%= classes %>" data-date="<%= cell.date %>" data-weekday="<%= cell.weekday %>"
               data-plan-count="<%= cell.plan.length %>" data-entry-count="<%= cell.entryCount %>" data-review-due="<%= cell.reviewDue %>"
               href="/calendar?month=<%= grid.month %>&day=<%= cell.date %>"<% if (cell.date === detail.date) { %>
               aria-current="date"<% } %>
               aria-label="<%= cell.date %> <%= cell.weekday %><%= cell.entryCount ? `，${cell.entryCount} 项截止` : '' %><%= cell.plan.length ? `，${cell.plan.length} 个时间块` : '' %><%= cell.reviewDue ? `，${cell.reviewDue} 张待复习` : '' %>">
              <span class="calday-num">
                <%= cell.dayOfMonth %>
                <% if (cell.hasDiary) { %><span class="calday-diary" title="这天写了日记" aria-hidden="true"></span><% } %>
              </span>

              <% if (cell.reviewDue) { %>
                <span class="calday-load" style="--load:<%= load.toFixed(3) %>"><%= cell.reviewDue %></span>
              <% } %>

              <span class="calday-items">
                <% cell.entries.forEach(entry => { %>
                  <span class="calpill <%= entry.overdue ? 'is-overdue' : '' %>"><%= entry.label %></span>
                <% }) %>
                <% if (cell.overflow) { %><span class="calpill is-more">+<%= cell.overflow %></span><% } %>
                <% cell.plan.forEach(block => { %>
                  <span class="calpill is-plan"><% if (block.from) { %><b><%= block.from %></b> <% } %><%= block.what %></span>
                <% }) %>
              </span>
            </a>
          <% }) %>
        <% }) %>
      </div>
    </div>

    <p class="muted calhint">
      日期来自条目 frontmatter 的 <code>deadline</code> 和待办后面的 <code>@<%= grid.today %></code>；
      时间块来自当天日记 frontmatter 的 <code>plan</code>；
      角上的数字是那天 FSRS 排到的复习量。
    </p>
  </div>

  <aside class="col-side calside">
    <h2>
      <%= detail.date %> <%= detail.weekday %>
      <% if (detail.isToday) { %><span class="chip due-today">今天</span>
      <% } else if (detail.isPast) { %><span class="chip">已过</span>
      <% } else { %><span class="chip"><%= detail.daysFromToday %> 天后</span><% } %>
    </h2>

    <% if (detail.entries.length) { %>
      <h3>截止与待办</h3>
      <ul class="notelist">
        <% detail.entries.forEach(entry => { %>
          <li>
            <a href="/note/<%= encodePath(entry.path) %>"><%= entry.label %></a>
            <span class="chip <%= entry.overdue ? 'overdue' : '' %>"><%= entry.source %></span>
            <% if (entry.detail && entry.detail !== entry.source) { %>
              <span class="muted"><%= entry.detail %></span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <h3>时间块</h3>
    <ul class="planlist" data-plan-list<% if (!detail.plan.length) { %> hidden<% } %>>
      <% detail.plan.forEach(block => { %>
        <li>
          <% if (block.from) { %><span class="plan-time"><%= block.from %>–<%= block.to %></span><% } %>
          <%= block.what %>
        </li>
      <% }) %>
    </ul>
    <% if (!detail.plan.length) { %>
      <p class="muted" data-plan-empty>这天还没排。</p>
    <% } %>

    <% if (!readOnly) { %>
      <form class="planform" method="post" action="/calendar/plan" data-plan-form>
        <input type="hidden" name="date" value="<%= detail.date %>">
        <input type="hidden" name="expectedHash" value="<%= detail.diary.hash %>">
        <div class="planform-times">
          <label>开始 <input type="time" name="from" step="300"></label>
          <label>结束 <input type="time" name="to" step="300"></label>
        </div>
        <label class="planform-what">做什么
          <input type="text" name="what" required maxlength="120" placeholder="写引言">
        </label>
        <button class="button primary small" type="submit">排进这天</button>
        <p class="muted planform-hint">会写进 <code><%= detail.diary.path %></code> 的 <code>plan</code> 字段。
          不填时间就是一条没有时段的计划。</p>
      </form>
    <% } %>

    <h3>复习</h3>
    <% if (detail.reviewDue) { %>
      <p><a href="/review"><%= detail.reviewDue %> 张</a>排在这天到期。</p>
    <% } else { %>
      <p class="muted">这天没有卡片到期。</p>
    <% } %>

    <h3>日记</h3>
    <div data-diary-slot>
      <% if (detail.diary.exists) { %>
        <p><a href="/note/<%= encodePath(detail.diary.path) %>">打开这天的日记</a></p>
      <% } else if (!readOnly) { %>
        <form class="inline-form" method="post" action="/diary/today">
          <input type="hidden" name="date" value="<%= detail.date %>">
          <button class="button small" type="submit">按模板新建</button>
        </form>
      <% } else { %>
        <p class="muted">这天没有日记。</p>
      <% } %>
    </div>

    <% if (detail.onThisDay.length) { %>
      <h3>历年今日</h3>
      <ul class="notelist">
        <% detail.onThisDay.forEach(entry => { %>
          <li>
            <span class="muted"><%= entry.label %></span>
            <a href="/note/<%= encodePath(entry.path) %>"><%= entry.title %></a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </aside>
</div>

<script src="/static/calendar.js" defer></script>
<%- include('partials/foot') %>
