<%- include('partials/head') %>

<section class="hero">
  <span class="eyebrow">按天留一笔</span>
  <h1>月历备注</h1>
  <p class="muted">点击日期记录想法和安排，备注与截止事项会显示在日期卡片里。</p>
  <nav class="boardnav calnav" aria-label="月份导航">
    <a class="button small" href="/calendar?month=<%= previousMonth %>" aria-label="上个月">← 上月</a>
    <strong class="calendar-month"><%= Number(month.slice(0, 4)) %> 年 <%= Number(month.slice(5)) %> 月</strong>
    <a class="button small" href="/calendar?month=<%= nextMonth %>" aria-label="下个月">下月 →</a>
    <a class="button small" href="/calendar">今天</a>
    <a class="calendar-deadlines" href="/deadlines">截止日期时间轴 →</a>
  </nav>
</section>

<div class="columns callayout">
  <section class="col-main calgrid" aria-label="<%= month %> 月历">
    <div class="calgrid-head" aria-hidden="true">
      <% weekdays.forEach(day => { %><span><%= day %></span><% }) %>
    </div>
    <div class="calgrid-body">
      <% weeks.forEach(week => week.forEach((date, dayIndex) => {
        const text = notes.get(date)?.body || '';
        const entries = entriesByDate.get(date) || [];
      %>
        <a class="calday<%= date.startsWith(month) ? '' : ' is-outside' %><%= dayIndex >= 5 ? ' is-weekend' : '' %><%= date === today ? ' is-today' : '' %><%= date === selected ? ' is-selected' : '' %>"
           href="/calendar?month=<%= date.slice(0, 7) %>&date=<%= date %>"
           data-calendar-day="<%= date %>" aria-label="<%= date %><%= text.trim() ? '，有备注' : '' %><%= entries.length ? '，' + entries.length + ' 个截止事项' : '' %>"<% if (date === selected) { %> aria-current="date"<% } %>>
          <span class="calday-num"><%= Number(date.slice(8)) %></span>
          <span class="calendar-note-preview" data-calendar-preview><%= text.trim() %></span>
          <span class="calday-items">
            <% entries.slice(0, 2).forEach(entry => { %>
              <span class="calpill<%= entry.overdue ? ' is-overdue' : '' %>" title="<%= entry.source %>：<%= entry.label %>"><%= entry.label %></span>
            <% }) %>
            <% if (entries.length > 2) { %><span class="calpill is-more">还有 <%= entries.length - 2 %> 项</span><% } %>
          </span>
        </a>
      <% })) %>
    </div>
  </section>

  <section class="col-side calside" aria-labelledby="calendar-day-title">
    <h2 id="calendar-day-title"><%= selected %> <span class="muted"><%= selectedWeekday %></span></h2>
    <% if (readOnly) { %>
      <h3>当天备注</h3>
      <p class="calendar-note-readonly"><%= selectedNote?.body || '这天还没有备注。' %></p>
    <% } else { %>
      <form class="calendar-note-form" action="/calendar/notes" method="post" data-calendar-form>
        <input type="hidden" name="date" value="<%= selected %>">
        <input type="hidden" name="month" value="<%= month %>">
        <input type="hidden" name="expectedHash" value="<%= selectedNote?.hash || '' %>">
        <label for="calendar-note">当天备注</label>
        <textarea id="calendar-note" name="text" rows="8" placeholder="写下这天的想法、安排或备忘…"><%= selectedNote?.body || '' %></textarea>
        <p class="muted calendar-note-hint">支持多行文字；清空后保存即可删除备注。</p>
        <button class="button primary" type="submit">保存备注</button>
        <p class="calendar-note-status" data-calendar-status role="status" aria-live="polite"></p>
      </form>
    <% } %>
    <p class="calendar-note-links">
      <a data-calendar-note-link href="/note/<%= encodePath(selectedPath) %>"<% if (!selectedNote) { %> hidden<% } %>>打开笔记</a>
      <a href="/history?path=<%= encodeURIComponent(selectedPath) %>">备注历史</a>
    </p>
    <h3>当天截止事项</h3>
    <% const selectedEntries = entriesByDate.get(selected) || []; %>
    <% if (!selectedEntries.length) { %><p class="muted">这天没有截止事项。</p><% } else { %>
      <ul class="calendar-deadline-list">
        <% selectedEntries.forEach(entry => { %>
          <li><a href="/note/<%= encodePath(entry.path) %>"><%= entry.label %></a><span class="muted"><%= entry.source %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<% if (!readOnly) { %><script src="/static/calendar.js" defer></script><% } %>
<%- include('partials/foot') %>
