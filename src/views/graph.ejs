<%- include('partials/head') %>
<section class="hero">
  <h1><%= title %></h1>
  <nav class="boardnav">
    <a class="chip <%= type === 'link' ? 'active' : '' %>" href="/graph">双链图谱</a>
    <a class="chip <%= type === 'prereq' ? 'active' : '' %>" href="/graph?type=prereq">知识依赖</a>
    <a class="chip" href="/health">知识库体检</a>
  </nav>
  <p class="muted">
    <%= graph.nodes.length %> 个节点 · <%= graph.edges.length %> 条边<% if (type === 'prereq') { %>
    　依赖边人工维护在 vault 的 <code>graph/prereq.yaml</code> 里——猜出来的依赖不可信，
    而这张图的用处正是「哪些前置我还没打通」<% } %>
  </p>
</section>

<% if (graph.nodes.length === 0) { %>
  <section class="card empty">
    <h2>还没有可画的东西</h2>
    <% if (type === 'prereq') { %>
      <p>在 vault 里建 <code>graph/prereq.yaml</code>，一行一条依赖：</p>
      <pre><code>计量/ch04: [计量/ch03, 概率论/ch07]
计量/ch05: [计量/ch04]</code></pre>
      <p class="muted">左边是后修，方括号里是它的前置。节点名对应 <code>notes/reading/</code> 下的路径。</p>
    <% } else { %>
      <p class="muted">笔记之间还没有 <code>[[双链]]</code>。</p>
    <% } %>
  </section>
<% } else { %>
  <div id="graph" class="graphbox" data-graph="<%= payload %>" data-type="<%= type %>"></div>

  <% if (graph.blocked.length || graph.orphans.length) { %>
  <div class="graph-findings">
  <% if (graph.blocked.length) { %>
    <section class="graph-finding">
      <h2>前置没打通 <span class="count"><%= graph.blocked.length %></span></h2>
      <p class="muted">这些章节的前置里还有没学完的。地基没打牢就往上堆，是自学最常见的失败方式。</p>
      <ul class="notelist">
        <% graph.blocked.forEach(row => { %>
          <li><strong><%= row.node %></strong><span class="muted">还缺：<%= row.unmet.join('、') %></span></li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <% if (graph.orphans.length) { %>
    <section class="graph-finding">
      <h2>孤岛笔记 <span class="count"><%= graph.orphans.length %></span></h2>
      <p class="muted">没有任何链接进出。记了但从没被再引用过的笔记，多半也从没被再看过。</p>
      <ul class="notelist">
        <% graph.orphans.slice(0, 30).forEach(node => { %>
          <li><a href="/note/<%= encodePath(node.path) %>"><%= node.label %></a></li>
        <% }) %>
      </ul>
    </section>
  <% } %>
  </div>
  <% } %>
<% } %>
<script src="/static/graph.js" defer></script>
<%- include('partials/foot') %>
